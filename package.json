{
  "name": "hualong-teacher",
  "version": "0.1.0",
  "private": true,
  "description": "化龙镇中心幼儿园电子资源平台 · 教师端小程序（原生）与本地契约 mock",
  "scripts": {
    "mock": "node mock/server.mjs",
    "mock:unbound": "node mock/server.mjs --unbound",
    "mock:no-term": "node mock/server.mjs --no-term",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "swagger": "node tools/swagger/server.mjs",
    "spec:inventory": "node tools/spec-inventory.mjs",
    "verify:build": "node tools/verify-build.mjs",
    "check:remote-scripts": "node scripts/check-remote-scripts.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "verify:release": "node tools/verify-build.mjs --release",
    "verify:schema": "node tools/schema-conformance.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "js-yaml": "^5.4.0",
    "miniprogram-automator": "^0.12.1",
    "miniprogram-ci": "^2.1.31",
    "swagger-ui-dist": "^5.32.14"
  }
}
