/* 上传表单（票据 15）。选择行与横排标签的尺寸在 styles/form-rows.wxss，本页不重写。
 *
 * 2026-08-27 逐格对着 screens/upload-resource.html 重排。换算因子 2（票据 01）。
 * 原型 `#fbfdfd`（输入框底色）在令牌层没有对应档，这里用 `--surface`：白卡上区分
 * 输入框靠的是那一圈描边，不是那 1% 的灰。缺口记在票据 27。
 */

.hl-card + .hl-card {
  margin-top: var(--space-2);
}

/* 顶部头图 —— 原型 upload-resource.html 的 `.banner`。原型的渐变有三站
 * （#0f766e → accent → #4fc4b9），第三站没有对应令牌，这里用两站。 */
.banner {
  position: relative;
  overflow: hidden;
  padding: 36rpx;
  margin-bottom: 28rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, var(--accent-dark), var(--accent));
  color: #fff;
}

/* 原型右上角那枚白色圆环，压在文字下面。 */
.banner::after {
  content: '';
  position: absolute;
  right: -68rpx;
  top: -76rpx;
  width: 296rpx;
  height: 296rpx;
  border: 40rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 50%;
}

.banner__kicker {
  position: relative;
  z-index: 1;
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: var(--radius-pill);
  background: rgba(255, 255, 255, 0.18);
  font-size: 22rpx;
  font-weight: 600;
}

.banner__title {
  position: relative;
  z-index: 1;
  margin-top: var(--space-3);
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.25;
}

.banner__desc {
  position: relative;
  z-index: 1;
  width: 540rpx;
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.92);
}

.up__state {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

/* 驳回原因是这一页最该被读到的一句话，所以它有自己的底色，不混在正文里。 */
.up__reason {
  padding: var(--space-2);
  border-radius: var(--radius-sm);
  background: var(--danger-light);
  color: var(--danger);
  font-size: 26rpx;
  line-height: 1.6;
}

/* ── 分节卡 ───────────────────────────────────────────────────────────────── */

/* 原型 `.chunk`：**一节一张卡**，标题与它的字段同在一张白卡里，卡与卡之间隔 10px。 */
.up__chunk {
  padding: 30rpx;
  border-radius: 32rpx;
}

.up__chunk + .up__chunk {
  margin-top: 20rpx;
}

/* 原型 `.section-head`：标题在左，一句提示在右。 */
.up__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.up__sec {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--fg);
}

/* 没有右侧提示时，标题自己要补回那段下边距。 */
.up__sec--solo {
  margin-bottom: 24rpx;
}

/* 区头右侧那句提示，与页尾那句说明同一种形态：灰、小、不抢。 */
.up__hint {
  font-size: 24rpx;
  line-height: 1.45;
  color: var(--muted);
}

/* ── 上传目标 ─────────────────────────────────────────────────────────────── */

/* 原型 `.target-grid`：两张并排的卡，各带字标、名称与一句说明。 */
.up__targets {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.up__target {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  min-height: 164rpx;
  padding: 22rpx;
  border: 1px solid var(--border);
  border-radius: 28rpx;
  background: var(--surface);
}

.up__target--on {
  border-color: var(--accent);
  background: var(--accent-light);
}

.up__target-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  background: var(--accent-light);
  color: var(--accent-dark);
  font-size: 24rpx;
  font-weight: 800;
}

/* 选中时卡底已是浅青，字标再用浅青就糊在一起了，翻成实心。 */
.up__target--on .up__target-mark {
  background: var(--accent);
  color: #fff;
}

.up__target-name {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.2;
}

.up__target-desc {
  font-size: 22rpx;
  line-height: 1.35;
  color: var(--muted);
}

/* ── 上传人信息（只读回显） ───────────────────────────────────────────────── */

/* 原型 `.profile`：姓名与班级两格并排。 */
.up__profile {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

/* 原型 `.readback`：比输入框更暗的底色，本身就在说「这一格不能填」。
 * `#f2f6f6` 令牌层没有这一档，用页面底色 —— 它在白卡上同样显得凹下去。 */
.up__readback {
  padding: 22rpx 24rpx;
  border: 1px solid var(--border);
  border-radius: 24rpx;
  background: var(--bg);
  color: var(--muted);
  font-size: 26rpx;
  font-weight: 700;
}

.up__note {
  margin-top: 16rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: var(--muted);
}

/* ── 材料表单 ─────────────────────────────────────────────────────────────── */

/* 原型 `.form`：一列，字段之间 11px。 */
.up__form {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.up__field {
  min-width: 0;
}

/* 原型 `.field label`：12px／750，与控件隔 6px。字数上限靠右（原型 `.limit` 是
 * `float:right`，这里用 `margin-left:auto`，WXSS 的浮动在 flex 行里不生效）。 */
.up__label {
  display: flex;
  align-items: baseline;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--fg);
}

.up__req {
  margin-left: 4rpx;
  color: var(--danger);
}

.up__limit {
  margin-left: auto;
  font-size: 22rpx;
  font-weight: 400;
  color: var(--muted);
}

/* 原型 `.input` 与 `.textarea` 是同一套描边框，只有高度不同。 */
.up__input,
.up__area {
  width: 100%;
  padding: 22rpx 24rpx;
  border: 1px solid var(--border);
  border-radius: 24rpx;
  background: var(--surface);
  font-size: 26rpx;
  color: var(--fg);
}

.up__area {
  min-height: 156rpx;
  line-height: 1.55;
}

/* 原型 `.image-box`：一条矮框，左边说选没选，右边一枚药丸按钮。 */
.up__imagebox {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 80rpx;
  padding: 0 22rpx;
  border: 1px solid var(--border);
  border-radius: 24rpx;
  background: var(--surface);
}

.up__imagenote {
  font-size: 22rpx;
  color: var(--muted);
}

/* 原型 `.mini-btn`：封面与 Word 附件两处共用。 */
.up__mini {
  flex: none;
  padding: 16rpx 22rpx;
  border-radius: var(--radius-pill);
  background: var(--accent-light);
  color: var(--accent-dark);
  font-size: 24rpx;
  font-weight: 800;
  white-space: nowrap;
}

/* 原型 `.upload-row`：名称与说明在左，按钮在右。 */
.up__row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx;
  border: 1px solid var(--border);
  border-radius: 24rpx;
  background: var(--surface);
}

.up__row-text {
  flex: 1;
  min-width: 0;
}

.up__row-name {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--fg);
}

.up__row-note {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: var(--muted);
}

/* 横排标签进了白卡，就要自己带一圈描边 —— 通用样式的底色是白，白卡上看不见。
 * 原型的 `.chip` 本来就是描边的，这里补的是同一件事。 */
.up__form .hl-chips {
  padding-bottom: 0;
}

.up__form .hl-chips__item {
  border: 1px solid var(--border);
  font-size: 24rpx;
  font-weight: 700;
}

.up__form .hl-chips__item--on {
  border-color: var(--accent);
}

/* 关联资源的滚轮行也在白卡里，同样要描边才分得出边界。 */
.up__form .hl-pick-row {
  border: 1px solid var(--border);
  border-radius: 24rpx;
}

/* ── 页尾 ─────────────────────────────────────────────────────────────────── */

/* 原型 `.actions`：保存草稿与提交审核并排，各占一半。 */
.up__actions {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.up__action {
  flex: 1;
  min-width: 0;
}

/* 缺项、超长与文件说明共用一种形态：它们都是「你现在还不能提交，原因是这个」。 */
.up__notice {
  padding: var(--space-2) 0;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--danger);
}
