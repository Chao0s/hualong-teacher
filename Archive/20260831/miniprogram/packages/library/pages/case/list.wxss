.hl-card + .hl-card {
  margin-top: var(--space-2);
}

/* 分区标题 —— 原型 case-library.html 的 `.sec`：16px/700 正文色，外边距 18px 0 10px。 */
.sec {
  margin: 36rpx 0 20rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--fg);
}

/* 筛选面板 —— 原型 case-library.html 的 `.filter-panel`：三行标签共处一张卡。 */
.filter-panel {
  padding: var(--space-2) var(--space-2) 0;
  margin-bottom: var(--space-3);
  border: 1px solid var(--border);
  border-radius: 24rpx;
  background: var(--surface);
}

.kase {
  display: flex;
  align-items: center;
  gap: var(--space-3);
}

/* 原型的 `.thumb` 是 68px 见方并带一道细边，已建版本只有 44px。 */
.kase__thumb {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 136rpx;
  height: 136rpx;
  border: 1px solid var(--border);
  border-radius: 24rpx;
  background: var(--green-light);
  color: var(--green);
  font-size: 34rpx;
  font-weight: 600;
  flex: none;
}

.kase__body {
  flex: 1;
  min-width: 0;
}

.kase__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
}

/* 原型 resource-center.html 的 `.summary` 用正文色，不是弱化色。 */
.kase__excerpt {
  margin-top: var(--space-2);
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--fg);
  /* 两行足够看出这条讲什么；再多就该点进去读了。 */
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
