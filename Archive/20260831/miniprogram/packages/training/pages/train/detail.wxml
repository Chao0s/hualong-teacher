<view class="hl-page" wx:if="{{ready}}">
  <view wx:if="{{errorText}}" class="hl-error">
    {{errorText}}
    <text wx:if="{{errorCanRetry}}" class="hl-error__retry" bindtap="onRetryLoad">重试</text>
    <text wx:if="{{errorRequestId}}" class="hl-error__id">故障码 {{errorRequestId}}</text>
  </view>

  <view wx:if="{{loading}}" class="hl-loading">加载中…</view>

  <block wx:if="{{train && !loading}}">
    <!-- 原型 training-detail.html 的 `.head`：阶段徽章是压在标题**上方**的一枚小记号
         （`.kicker`），下面两行灰字 —— 第一行是时间、地点、主讲，用「·」串成**一行**；
         第二行是研修正文。原型没有单独的「研修通知」一节，正文就写在这里。 -->
    <view class="hl-card detail">
      <view class="detail__top">
        <text class="hl-pill {{train.phase_pill}}">{{train.phase_label}}</text>
        <!-- 已发布是常态，不挂徽章；已撤回才挂，因为它改变了这一页有什么。 -->
        <text wx:if="{{train.status_label}}" class="hl-pill {{train.status_pill}}">{{train.status_label}}</text>
      </view>
      <view class="detail__title">{{train.training_title}}</view>
      <!-- 研修时间：服务端给什么钟点就是什么钟点，客户端不换算（§1.2）。
           串这一行的「·」是拼字符串，不是时间算术 —— 开始与结束各自原样印出来。 -->
      <view class="hl-card__meta">{{train.when_label}}</view>
      <view class="hl-card__meta detail__body">{{train.training_content}}</view>
    </view>

    <view wx:if="{{train.withdrawn_notice}}" class="hl-card detail__notice">{{train.withdrawn_notice}}</view>

    <!-- 研修材料排在线上会议**之前**，与原型同序。 -->
    <view class="hl-section-title detail__sec">
      研修材料<text class="detail__sec-hint">预览 / 下载</text>
    </view>
    <!-- 研修材料全部可选，不强制主文件（F9）：一份也没有的研修照常显示。
         原型把所有材料排进**同一张卡**，行与行之间只有一条细线，不是一行一张卡。 -->
    <view wx:if="{{train.materials.length === 0}}" class="hl-card hl-empty">暂无研修材料</view>
    <view wx:else class="hl-card">
      <!-- 原型 `.file`：文件名在左，「预览」「下载」两枚在右。两枚都落到同一件事 ——
           §8.4 现签短时 URL，再交给 wx.previewImage 或 wx.openDocument。小程序没有
           文件系统下载，也没有独立的预览器，两个词在这里是同一个动作的两种说法。 -->
      <view
        wx:for="{{train.materials}}"
        wx:key="file_id"
        class="detail__file"
        data-id="{{item.file_id}}"
        data-name="{{item.file_name}}">
        <text class="detail__file-name">{{item.file_name}}</text>
        <view class="detail__file-acts">
          <text
            class="detail__file-act"
            data-id="{{item.file_id}}"
            data-name="{{item.file_name}}"
            catchtap="onOpenMaterial">预览</text>
          <text
            class="detail__file-act"
            data-id="{{item.file_id}}"
            data-name="{{item.file_name}}"
            catchtap="onOpenMaterial">下载</text>
        </view>
      </view>
    </view>

    <block wx:if="{{train.meeting}}">
      <view class="hl-section-title detail__sec">
        线上会议<text class="detail__sec-hint">复制后打开</text>
      </view>
      <view class="hl-card">
        <!-- 外部会议，小程序不内嵌打开，只提供复制（F9）。原型把链接原文也印出来。 -->
        <view class="meeting__title">{{train.meeting.title}}</view>
        <view class="meeting__url">{{train.meeting.url}}</view>
        <view class="meeting__hint">请复制链接到浏览器或会议 App 打开。</view>
        <view class="meeting__row" bindtap="onCopyMeeting">
          <text class="meeting__copy">复制会议链接</text>
        </view>
      </view>
    </block>

    <!-- ── 报名入口（原型 `#signupBlock`）──────────────────────────────────
         2026-08-27 补建。契约的两个端点都没有请求体，也不携带用户内容，所以不过内容
         安全闸门 —— 纯状态转移。开始之后参与状态冻结，那时这一节只剩一行理由。 -->
    <block wx:if="{{registration.show}}">
      <view class="hl-section-title detail__sec">
        报名入口<text class="detail__sec-hint">最新研修</text>
      </view>
      <view class="hl-card signup">
        <view class="signup__desc">报名后将自动记录到教师个人研修档案。请确认时间安排后提交报名。</view>
        <view
          wx:if="{{registration.open}}"
          class="hl-btn hl-btn--block {{registration.registered ? 'hl-btn--hollow' : ''}}"
          bindtap="onRegistrationTap">
          {{registering ? '处理中…' : registration.label}}
        </view>
        <view wx:if="{{registration.reason}}" class="signup__reason">{{registration.reason}}</view>
      </view>
    </block>

    <!-- ── 我的反馈（票据 16）─────────────────────────────────────────────
         整个教研培训模块唯一的写入点。入口关着的时候是一行说明，不是一个会当面
         拒绝人的按钮。 -->
    <view class="hl-section-title">我的反馈</view>

    <view wx:if="{{entry.reason}}" class="hl-card hl-empty">{{entry.reason}}</view>

    <block wx:if="{{entry.open}}">
      <!-- 第一阶段：写。 -->
      <block wx:if="{{stage === 'edit'}}">
        <view class="hl-card">
          <textarea
            class="fb__input"
            value="{{feedbackText}}"
            placeholder="写下这次研修带给你的收获或建议"
            maxlength="-1"
            bindinput="onFeedbackInput" />
          <view class="fb__count {{feedbackTooLong ? 'fb__count--over' : ''}}">
            {{feedbackText.length}} / 1000
          </view>
        </view>
        <view wx:if="{{feedbackTooLong}}" class="fb__reason">超过 1000 字，请精简后再预览。</view>
        <view
          class="hl-btn hl-btn--block {{feedbackTooLong ? 'fb__btn--off' : ''}}"
          bindtap="onPreviewTap">预览</view>
        <view class="fb__reason">提交前必须完整预览。预览里的内容就是提交的内容，确认后不能修改。</view>
      </block>

      <!-- 第二阶段：读完最终内容。读到底才解锁确认。 -->
      <block wx:if="{{stage === 'preview'}}">
        <scroll-view class="fb__preview" scroll-y="true" bindscrolltolower="onPreviewEnd">
          <view class="fb__preview-text">{{preview.body.feedback_text}}</view>
          <view class="fb__preview-end">—— 以上是全部内容 ——</view>
        </scroll-view>
        <view wx:if="{{!previewedInFull}}" class="fb__reason">请读到最后一行，再确认提交。</view>
        <view wx:if="{{gateError}}" class="fb__reason">{{gateError}}</view>
        <view
          class="hl-btn hl-btn--block {{previewedInFull ? '' : 'fb__btn--off'}}"
          bindtap="onConfirmTap">
          {{submitting ? '提交中…' : '确认提交'}}
        </view>
        <view class="hl-btn hl-btn--hollow hl-btn--block" bindtap="onBackToEdit">返回修改</view>
      </block>
    </block>

    <!-- 第三阶段：已提交，内容锁定。 -->
    <view wx:if="{{stage === 'done'}}" class="hl-card">
      <view class="fb__preview-text">{{preview.body.feedback_text}}</view>
      <view class="fb__reason">已提交，等待审核通过后会出现在下面的公开反馈里。</view>
    </view>

    <!-- 公开回馈流：只有已公开的那些，且活动仍在（F9）。
         原型把回馈排进**同一张卡**，行与行之间只有一条细线。 -->
    <view class="hl-section-title">公开反馈</view>
    <view wx:if="{{feedbacks.length === 0 && !loadingFeedback}}" class="hl-card hl-empty">暂无公开反馈</view>
    <view wx:else class="hl-card">
      <view wx:for="{{feedbacks}}" wx:key="feedback_id" class="fb__row">
        <view class="fb__who">
          <text class="fb__teacher">{{item.teacher_name}}</text>
          <text class="fb__time">{{item.time_label}}</text>
        </view>
        <view class="fb__said">{{item.feedback_text}}</view>
      </view>
    </view>
    <view wx:if="{{feedbackCursor}}" class="hl-btn hl-btn--hollow hl-btn--block" bindtap="onMoreFeedback">
      {{loadingFeedback ? '加载中…' : '加载更多'}}
    </view>
  </block>
</view>
