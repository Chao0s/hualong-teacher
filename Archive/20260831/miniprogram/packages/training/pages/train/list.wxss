.hl-card + .hl-card {
  margin-top: var(--space-2);
}

.train__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
}

/* 时间是这一页的主信息（票据 14 验收项），所以它比同一行的其余元信息重。 */
.train__time {
  margin-right: var(--space-2);
  color: var(--fg);
  font-weight: 600;
}

/* 原型 training-list.html 的 `.summary` 用正文色，不是弱化色。 */
.train__excerpt {
  margin-top: var(--space-2);
  font-size: 24rpx;
  line-height: 1.55;
  color: var(--fg);
  /* 两行足够看出这场讲什么；再多就该点进去读了。 */
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

/* ── 我的档案入口 —— 原型 `.profile-grid` ────────────────────────────────── */

.sec {
  margin: 0 0 20rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--fg);
}

/* 原型：两列等宽，格间 10px。 */
.entry {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.entry__card {
  padding: 24rpx;
  border: 1px solid var(--border);
  border-radius: 28rpx;
  background: var(--surface);
}

.entry__title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--fg);
}

.entry__desc {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: var(--muted);
}
