<view wx:if="{{ready}}" class="hl-page hl-stack">
  <view wx:if="{{loading}}" class="hl-loading">加载中…</view>

  <view wx:if="{{errorText}}" class="hl-error">
    {{errorText}}
    <text wx:if="{{errorRequestId}}" class="hl-error__id">故障编号 {{errorRequestId}}</text>
    <text wx:if="{{errorCanRetry}}" class="hl-error__retry" bindtap="onRetryLoad">重试</text>
  </view>

  <!-- 假期与已发布都是只读**状态**，不是错误：一行理由，不是一个弹窗。 -->
  <view wx:if="{{readonly}}" class="hl-card co-readonly">{{readonlyReason}}</view>

  <block wx:if="{{!loading && draft}}">
    <!-- ── edit ───────────────────────────────────────────────────────── -->
    <view wx:if="{{stage === 'edit'}}" class="hl-stack">
      <view class="hl-card">
        <view class="co-field">
          <view class="co-field__label">活动名称</view>
          <input
            class="co-input"
            value="{{draft.moment_title}}"
            maxlength="{{limits.moment_title}}"
            disabled="{{readonly}}"
            placeholder="例如：端午艾草手作"
            data-field="moment_title"
            bindinput="onTextInput" />
        </view>

        <view class="co-field">
          <view class="co-field__label">活动评语</view>
          <textarea
            class="co-textarea"
            value="{{draft.moment_content}}"
            maxlength="{{limits.moment_content}}"
            disabled="{{readonly}}"
            placeholder="孩子们做了什么、说了什么"
            data-field="moment_content"
            bindinput="onTextInput" />
        </view>

        <picker mode="date" value="{{draft.moment_date}}" disabled="{{readonly}}" bindchange="onDateChange">
          <view class="hl-pick-row">
            <view class="hl-pick-row__label">活动日期<text class="hl-pick-row__required">*</text></view>
            <view class="hl-pick-row__value {{draft.moment_date ? '' : 'hl-pick-row__value--empty'}}">
              {{draft.moment_date ? draft.moment_date : '请选择'}}
            </view>
          </view>
        </picker>

        <!--
          照片与名称、评语同在一张卡里（原型 home-school-moment-publish.html 的
          `.chunk.form-card` 一节收下三者）。

          **只有图片入口，一个视频入口也没有**（DO-NOT-BUILD 12）：这里没有
          视频标签、没有取景组件、没有任何通往视频的按钮。负向断言在
          tests/moments.test.mjs 里逐个字符串扫这个文件。
        -->
        <view class="co-field co-field--photos">
          <view class="co-field__label">添加照片（最多 {{imageLimit}} 张）</view>
          <!-- 原型 `.photo-row`：一排方格，第一格是虚线描边的「＋ 添加」，其余是缩略图。
               2026-08-27 改回原型 —— 此前每张是一行「照片 1 ／ 移除」的文字。 -->
          <view class="co-photos">
            <view
              wx:if="{{!readonly && draft.file_id.length < imageLimit}}"
              class="co-photos__add"
              bindtap="onPickPhotos">
              <text class="co-photos__plus">＋</text>
              <text>{{picking ? '上传中…' : '添加'}}</text>
            </view>
            <view wx:for="{{photos}}" wx:key="file_id" wx:for-index="pi" class="co-photos__item">
              <image
                class="co-photos__img"
                src="{{item.url}}"
                mode="aspectFill"
                data-index="{{pi}}"
                bindtap="onPhotoTap" />
              <view
                wx:if="{{!readonly}}"
                class="co-photos__remove"
                data-file-id="{{item.file_id}}"
                bindtap="onRemovePhoto">移除</view>
            </view>
          </view>
          <view wx:if="{{photoNotice}}" class="co-notice">{{photoNotice}}</view>
        </view>
      </view>

      <!-- 原型「本次涉及幼儿」那一节：左边两行字，右边一个大百分比，下面一条进度条，
           再下面一张一行的小表。2026-08-27 补建 —— 此前只有勾选网格，没有这块统计。 -->
      <view class="hl-card">
        <view class="co-cover">
          <view class="co-cover__text">
            <view class="co-cover__title">本次涉及幼儿</view>
            <view class="co-cover__hint">已勾选 {{coverage.selected}} / {{coverage.total}} 人</view>
          </view>
          <text class="co-cover__rate">{{coverage.rate}}%</text>
        </view>
        <view class="co-cover__bar">
          <view class="co-cover__fill" style="width:{{coverage.rate}}%"></view>
        </view>
        <view class="co-cover__row">
          <text class="co-cover__cell co-cover__cell--name">{{className}}</text>
          <text class="co-cover__cell">{{coverage.selected}}人</text>
          <text class="co-cover__cell">
            <text class="hl-pill {{coverage.rate >= 80 ? 'hl-pill--ok' : 'hl-pill--info'}}">{{coverage.rate}}%</text>
          </text>
        </view>
      </view>

      <view class="hl-card">
        <hl-child-picker
          mode="multi"
          label="幼儿名单"
          class-name="{{className}}"
          children="{{children}}"
          value="{{draft.child_id}}"
          required="{{true}}"
          disabled="{{readonly}}"
          bind:change="onChildrenChange" />
      </view>

      <view wx:if="{{blockers.length}}" class="hl-card co-blockers">
        <view class="co-field__label">还差这几项才能发布</view>
        <view wx:for="{{blockers}}" wx:key="key" class="co-blockers__item">{{item.text}}</view>
      </view>

      <button class="hl-btn hl-btn--block" disabled="{{readonly}}" bindtap="onPreviewTap">预览并发布</button>
    </view>

    <!-- ── preview ────────────────────────────────────────────────────── -->
    <view wx:elif="{{stage === 'preview'}}" class="hl-stack">
      <view class="hl-section-title">发布前请完整看一遍</view>
      <scroll-view class="co-preview" scroll-y bindscrolltolower="onPreviewEnd">
        <view class="hl-card">
          <view class="hl-card__title">{{preview.draft.moment_title}}</view>
          <view class="hl-card__meta">{{preview.draft.moment_date}} · {{className}}</view>
          <view class="co-preview__text">{{preview.body.moment_content}}</view>
          <view class="hl-card__meta">照片 {{preview.photoCount}} 张</view>
          <view class="hl-card__meta">涉及幼儿：{{preview.childNames}}</view>
        </view>
      </scroll-view>

      <view wx:if="{{!previewedInFull}}" class="co-notice">请滑到底看完全部内容，之后才能发布。</view>

      <button class="hl-btn hl-btn--block" disabled="{{!previewedInFull || submitting}}" bindtap="onConfirmTap">
        {{submitting ? '发布中…' : '确认发布'}}
      </button>
      <button class="hl-btn hl-btn--hollow hl-btn--block" disabled="{{locked}}" bindtap="onBackToEdit">返回修改</button>
    </view>

    <!-- ── done ───────────────────────────────────────────────────────── -->
    <view wx:else class="hl-stack">
      <view class="hl-card">
        <view class="hl-card__title">已发布</view>
        <view class="hl-card__meta">家长现在就看得到。发布后内容不能再改。</view>
      </view>
      <button class="hl-btn hl-btn--block" bindtap="onBackTap">返回</button>
    </view>
  </block>
</view>
