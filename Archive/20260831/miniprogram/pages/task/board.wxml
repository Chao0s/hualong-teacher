<view class="hl-page" wx:if="{{ready}}">

  <view wx:if="{{errorText}}" class="hl-error">
    {{errorText}}
    <text wx:if="{{errorCanRetry}}" class="hl-error__retry" bindtap="onRetryLoad">重试</text>
    <text wx:if="{{errorRequestId}}" class="hl-error__id">故障码 {{errorRequestId}}</text>
  </view>

  <!-- 两节堆叠 —— 原型 teacher-tasks.html 的 `.sec` ＋ `.task-list`。 -->
  <block wx:for="{{sections}}" wx:key="key" wx:for-item="section">

    <view class="sec">
      {{section.title}}
      <!-- 计数只在这一节确实读完时才报。没读完就不报 —— 游标分页没有总数，
           报一个「已加载几条」冒充总数比不报更糟。 -->
      <text wx:if="{{section.countLabel}}" class="sec__hint">{{section.countLabel}}</text>
    </view>

    <view wx:if="{{section.loading && section.items.length === 0}}" class="hl-loading">加载中…</view>

    <!-- 空与失败是两种状态：读失败时不说「暂无」。 -->
    <view
      wx:if="{{!section.loading && section.items.length === 0 && !errorText}}"
      class="hl-card hl-empty">暂无{{section.title}}</view>

    <view
      wx:for="{{section.items}}"
      wx:key="task_id"
      class="hl-card task"
      data-id="{{item.task_id}}"
      bindtap="onTap">
      <!-- 标题与状态徽章的字号在原型上都比通用类小一档，所以这一页用自己的两个类
           （见 board.wxss），不套 `hl-card__title` 与 `hl-pill`。 -->
      <view class="task__row">
        <text class="task__title">{{item.task_title}}</text>
        <text class="task__status {{item.status_class}}">{{item.status_label}}</text>
      </view>
      <view class="task__meta">
        截止 {{item.due_label}}
        <text wx:if="{{item.creator_label}}"> · {{item.creator_label}}</text>
      </view>
      <view wx:if="{{item.closed_note}}" class="task__closed">{{item.closed_note}}</view>
      <view class="task__intro">{{item.task_intro}}</view>
    </view>

    <view
      wx:if="{{!section.exhausted && section.items.length > 0}}"
      class="sec__more"
      data-key="{{section.key}}"
      bindtap="onMoreTap">{{section.loading ? '加载中…' : '加载更多'}}</view>
  </block>
</view>
