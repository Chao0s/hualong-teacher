<block wx:for="{{sections}}" wx:key="title" wx:for-item="group">
  <view class="hl-section-title">{{group.title}}</view>
  <view
    wx:for="{{group.entries}}"
    wx:key="key"
    class="hl-card entry"
    data-key="{{item.key}}"
    bindtap="onTap">
    <view class="entry__badge">{{item.badge}}</view>
    <view class="entry__text">
      <view class="hl-card__title">{{item.label}}</view>
      <view wx:if="{{item.desc}}" class="hl-card__meta">{{item.desc}}</view>
    </view>
    <hl-icon name="icon-10" color="muted" size="32rpx" />
  </view>
</block>
