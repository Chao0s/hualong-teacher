/* 原型 `.tabs`：吸底、5 等分、上描边、28px 底部内边距留给 Home 指示条。
 * 组件有样式隔离，颜色不靠外部令牌，直接写死。 */
.tabs {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  align-items: center;
  padding: 16rpx 12rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e0e8e8;
  background: #ffffff;
}

.tab {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 0;
}

.tab__icon {
  width: 44rpx;
  height: 44rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 44rpx 44rpx;
}

.tab__label {
  font-size: 20rpx;
  font-weight: 400;
  white-space: nowrap;
  color: #868686;
}

.tab--on .tab__label {
  color: #189b91;
}

