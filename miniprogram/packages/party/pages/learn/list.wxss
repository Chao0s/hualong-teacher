.hl-card + .hl-card {
  margin-top: var(--space-2);
}

.study__meta {
  display: flex;
  gap: var(--space-2);
}

.study__type {
  color: var(--accent-dark);
}

.study__excerpt {
  margin-top: var(--space-2);
  font-size: 26rpx;
  color: var(--muted);
  /* 两行足够看出这条讲什么；再多就该点进去读了。 */
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
