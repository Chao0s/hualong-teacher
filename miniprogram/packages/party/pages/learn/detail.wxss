.hl-card + .hl-card {
  margin-top: var(--space-2);
}

/* 原型的类型徽章是红系，与党建学习的色标一致（party-study-detail.html `.badge`）。 */
.detail__type {
  background: var(--danger-light);
  color: var(--danger);
}

.detail__title {
  margin-top: var(--space-2);
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.5;
  color: var(--fg);
}

.detail__meta {
  display: flex;
  gap: var(--space-2);
}

/* 「文件预览」框 —— 原型 `.preview`。底色比卡片略浅一档在小程序上看不出来，
 * 所以只留边框，不写死一个 #fafcfc。 */
.preview {
  margin-top: var(--space-3);
  padding: var(--space-3);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
}

.preview__title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--fg);
}

.preview__body {
  margin-top: var(--space-2);
  font-size: 30rpx;
  line-height: var(--line-cjk);
  color: var(--fg);
  white-space: pre-wrap;
}

.video {
  margin-top: var(--space-3);
  padding-top: var(--space-3);
  border-top: 1px solid var(--border);
}

.video__title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--fg);
}

.video__hint {
  margin-top: var(--space-1);
  font-size: 26rpx;
  color: var(--muted);
}

.video__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--space-2);
  padding: var(--space-2);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
}

.video__name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--fg);
}

.video__copy {
  margin-left: var(--space-2);
  color: var(--accent-dark);
  font-size: 26rpx;
  font-weight: 600;
  flex: none;
}
