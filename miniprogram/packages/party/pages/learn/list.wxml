<view class="hl-page" wx:if="{{ready}}">
  <!-- 原型 party-study-list.html 顶部的摘要卡：一句话说明这张列表收的是什么。 -->
  <view class="summary">
    <view class="summary__title">全部学习文件</view>
    <view class="summary__desc">集中查看政策文件、专题学习材料与园内制度学习内容。</view>
  </view>

  <view wx:if="{{errorText}}" class="hl-error">
    {{errorText}}
    <text wx:if="{{errorCanRetry}}" class="hl-error__retry" bindtap="onRetryList">重试</text>
    <text wx:if="{{errorRequestId}}" class="hl-error__id">故障码 {{errorRequestId}}</text>
  </view>

  <view wx:if="{{loadingFirst}}" class="hl-loading">加载中…</view>

  <block wx:if="{{!loadingFirst}}">
    <!-- 空与失败是两种状态：读失败时不说「暂无」，那是把读不到说成没有东西可读。 -->
    <view wx:if="{{items.length === 0 && !errorText}}" class="hl-card hl-empty">暂无学习资料</view>

    <!-- 原型 party-study-list.html 的 `.item` 是「色块＋两行文字＋预览」的定高一行
         （min-height 68px）。服务层还给了一条 excerpt，但原型这一行放不下第三行字，
         所以不绑它；摘要在详情页的正文里看得到。 -->
    <view
      wx:for="{{items}}"
      wx:key="study_id"
      class="hl-card study"
      data-id="{{item.study_id}}"
      bindtap="onTap">
      <view class="study__mark">学</view>
      <view class="study__text">
        <text class="hl-card__title">{{item.study_title}}</text>
        <!-- 原型 `.meta` 三格同色，类型不比日期重要，所以没有一格是彩色的。 -->
        <view class="hl-card__meta study__meta">
          <text>{{item.type_label}}</text>
          <text>{{item.published_label}}</text>
          <text wx:if="{{item.department_label}}">{{item.department_label}}</text>
        </view>
      </view>
      <text class="study__action">预览</text>
    </view>

    <view wx:if="{{loadingMore}}" class="hl-loading">加载更多…</view>
    <view wx:if="{{exhausted && items.length > 0}}" class="hl-loading">没有更多了</view>
  </block>
</view>
