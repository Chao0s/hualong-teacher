<view class="hl-page" wx:if="{{ready}}">
  <view wx:if="{{errorText}}" class="hl-error">
    {{errorText}}
    <text wx:if="{{errorCanRetry}}" class="hl-error__retry" bindtap="onRetryLoad">重试</text>
    <text wx:if="{{errorRequestId}}" class="hl-error__id">故障码 {{errorRequestId}}</text>
  </view>

  <view wx:if="{{loading}}" class="hl-loading">加载中…</view>

  <block wx:if="{{brand && !loading}}">
    <!-- 原型 party-brand-detail.html 的头图：标题压在渐变块的下沿。 -->
    <view class="hero">
      <view class="hero__title">{{brand.brand_title}}</view>
      <view class="hero__sub">{{brand.published_label}}</view>
    </view>

    <!-- 可空列：没有标签就整张卡不渲染，不留一条空白带。 -->
    <view wx:if="{{brand.tags.length > 0}}" class="hl-card detail__card">
      <view class="chips">
        <text wx:for="{{brand.tags}}" wx:key="*this" class="hl-pill chips__item">{{item}}</text>
      </view>
    </view>

    <view class="hl-card detail__card">
      <view class="section__title">主题介绍</view>
      <view class="detail__body">{{brand.brand_content}}</view>
    </view>

    <block wx:if="{{brand.files.length > 0}}">
      <view class="hl-section-title">附件</view>
      <view wx:for="{{brand.files}}" wx:key="file_id" class="hl-card detail__file">
        <text class="hl-card__title">{{item.file_name}}</text>
        <view class="hl-card__meta">{{item.usage_label}}</view>
      </view>
    </block>
  </block>
</view>
