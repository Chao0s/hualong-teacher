/* 摘要卡 —— 原型 party-brand-list.html 的 `.summary`，绿系。 */
.summary {
  padding: var(--space-4);
  margin-bottom: var(--space-4);
  border-radius: var(--radius);
  background: linear-gradient(135deg, #2f855a, var(--green), #88c35a);
  color: #fff;
}

.summary__title {
  font-size: 40rpx;
  font-weight: 600;
}

.summary__desc {
  margin-top: var(--space-1);
  font-size: 24rpx;
  opacity: 0.9;
}

.hl-card + .hl-card {
  margin-top: var(--space-2);
}

.brand {
  display: flex;
  align-items: center;
  gap: var(--space-3);
}

/* 原型的缩略块比学习与活动的色块大一档（54px 对 38px）。 */
.brand__thumb {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 108rpx;
  height: 108rpx;
  border-radius: var(--radius-sm);
  background: var(--green-light);
  color: var(--green);
  font-size: 36rpx;
  font-weight: 600;
  flex: none;
}

.brand__text {
  flex: 1;
  min-width: 0;
}

.brand__meta {
  display: flex;
  gap: var(--space-2);
}

.brand__tags {
  flex: 1;
  color: var(--accent-dark);
  /* 标签多的一条不换行撑高卡片；点进去就看得全。 */
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
