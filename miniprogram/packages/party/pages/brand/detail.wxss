/* 头图 —— 原型 party-brand-detail.html 的 `.hero`，比活动的头图高一档。 */
.hero {
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  min-height: 360rpx;
  padding: var(--space-4);
  border-radius: var(--radius);
  background: linear-gradient(135deg, #2f855a, var(--green), #88c35a);
  color: #fff;
}

.hero__title {
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.4;
}

.hero__sub {
  margin-top: var(--space-1);
  font-size: 24rpx;
  opacity: 0.9;
}

.hl-card {
  margin-top: var(--space-2);
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-1);
}

.chips__item {
  background: var(--green-light);
  color: var(--green);
}

.section__title {
  margin-bottom: var(--space-2);
  font-size: 30rpx;
  font-weight: 600;
  color: var(--fg);
}

.detail__body {
  font-size: 30rpx;
  line-height: var(--line-cjk);
  color: var(--fg);
  white-space: pre-wrap;
}
