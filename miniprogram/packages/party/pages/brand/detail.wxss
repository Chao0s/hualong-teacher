/* 品牌建设详情页 —— 逐格对着 screens/party-brand-detail.html 转写。
 * 换算因子 2，字重按入口页的先例落到 700。原型正文色 #3d3b36 令牌层没有这一档，用 --fg。 */

/* 头图 —— 原型 `.hero`：定高 180px，比活动的头图高一档，圆角也大一档。 */
.hero {
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  min-height: 360rpx;
  padding: 36rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #2f855a, var(--green), #88c35a);
  color: #fff;
}

.hero__title {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.24;
}

.hero__sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  opacity: 0.9;
}

/* 原型 `.card` 之间是 12px。附件那一族卡沿用全站的 .hl-card 规格，所以内边距与
 * 圆角只写在正文卡上，不写在这条通用规则里。 */
.hl-card {
  margin-top: 24rpx;
}

/* 原型 `.card`：内边距 15px，圆角 16px。 */
.detail__card {
  padding: 30rpx;
  border-radius: 32rpx;
}

/* 原型 `.chips` 的 gap 是 8px。 */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}

/* 原型 `.chip` 比通用 .hl-pill 高一档（上下 6px）。 */
.chips__item {
  padding: 12rpx 18rpx;
  background: var(--green-light);
  color: var(--green);
  font-weight: 700;
}

.section__title {
  margin-bottom: var(--space-2);
  font-size: 30rpx;
  font-weight: 700;
  color: var(--fg);
}

.detail__body {
  font-size: 26rpx;
  line-height: var(--line-cjk);
  color: var(--fg);
  white-space: pre-wrap;
}
