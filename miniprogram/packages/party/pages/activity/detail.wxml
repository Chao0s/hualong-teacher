<view class="hl-page" wx:if="{{ready}}">
  <view wx:if="{{errorText}}" class="hl-error">
    {{errorText}}
    <text wx:if="{{errorCanRetry}}" class="hl-error__retry" bindtap="onRetryLoad">重试</text>
    <text wx:if="{{errorRequestId}}" class="hl-error__id">故障码 {{errorRequestId}}</text>
  </view>

  <view wx:if="{{loading}}" class="hl-loading">加载中…</view>

  <block wx:if="{{activity && !loading}}">
    <!-- 原型 party-activity-detail.html 的头图：标题压在渐变块的下沿。 -->
    <view class="cover">
      <view class="cover__title">{{activity.activity_title}}</view>
      <view class="cover__sub">
        <text>党建活动</text>
        <text wx:if="{{activity.location_label}}"> · {{activity.location_label}}</text>
      </view>
    </view>

    <view class="hl-card detail__card">
      <view class="row">
        <text class="row__label">活动时间</text>
        <!-- 活动时间：服务端给什么钟点就是什么钟点，客户端不换算（§1.2）。 -->
        <text class="row__value">{{activity.time_label}}</text>
      </view>
    </view>

    <view class="hl-card detail__card">
      <view class="section__title">图文介绍</view>
      <view class="detail__body">{{activity.activity_content}}</view>

      <!-- 原型 `.article-photos`：一张大图压在上面，两张小图并排在下。
           这些是 `usage_key='inline_media'` 的附件，每张单独签一次短时地址
           （§8.4，不回可直接访问的地址）。签不出来的那一张不画。 -->
      <view wx:if="{{activity.photos.length > 0}}" class="photos">
        <image
          class="photos__main"
          src="{{activity.photos[0].url}}"
          mode="aspectFill"
          data-index="0"
          bindtap="onPhotoTap" />
        <view wx:if="{{activity.photos.length > 1}}" class="photos__row">
          <image
            wx:for="{{activity.photos}}"
            wx:for-index="i"
            wx:key="file_id"
            wx:if="{{i > 0}}"
            class="photos__small"
            src="{{item.url}}"
            mode="aspectFill"
            data-index="{{i}}"
            bindtap="onPhotoTap" />
        </view>
      </view>
    </view>

    <!-- 原型「附件下载」：一张卡，逐行分隔，行末一枚「下载」。
         活动的附件可以全空（F7），所以整块按有无开合，不留一个空标题。 -->
    <view wx:if="{{activity.files.length > 0}}" class="hl-card detail__card">
      <view class="section__title">附件下载</view>
      <view
        wx:for="{{activity.files}}"
        wx:key="file_id"
        class="download"
        data-id="{{item.file_id}}"
        data-name="{{item.file_name}}"
        bindtap="onDownloadTap">
        <text class="download__name">{{item.file_name}}</text>
        <text class="download__act">下载</text>
      </view>
    </view>
  </block>
</view>
