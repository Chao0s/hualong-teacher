/* 活动介绍页 —— 逐格对着 screens/party-activity-detail.html 转写。
 * 换算因子 2，字重按入口页的先例落到 700。原型正文色 #3d3b36 令牌层没有这一档，用 --fg。 */

/* 头图 —— 原型 `.cover`：定高 150px，标题压在渐变块的下沿。 */
.cover {
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  min-height: 300rpx;
  padding: 36rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #2563eb, #65b7ff);
  color: #fff;
}

.cover__title {
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.25;
}

.cover__sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  opacity: 0.9;
}

/* 原型 `.card` 之间是 12px。附件那一族卡沿用全站的 .hl-card 规格，所以内边距与
 * 圆角只写在正文卡上，不写在这条通用规则里。 */
.hl-card {
  margin-top: 24rpx;
}

/* 原型 `.card`：内边距 15px，圆角 16px。 */
.detail__card {
  padding: 30rpx;
  border-radius: 32rpx;
}

/* 「标签｜值」一行 —— 原型的 `.row`，标签列定宽 72px，值靠左对齐成一列。 */
.row {
  display: flex;
  gap: var(--space-2);
  font-size: 26rpx;
  line-height: 1.5;
}

.row__label {
  width: 144rpx;
  flex: none;
  color: var(--muted);
}

.row__value {
  flex: 1;
  min-width: 0;
  color: var(--fg);
}

.section__title {
  margin-bottom: var(--space-2);
  font-size: 30rpx;
  font-weight: 700;
  color: var(--fg);
}

.detail__body {
  font-size: 26rpx;
  line-height: var(--line-cjk);
  color: var(--fg);
  white-space: pre-wrap;
}

/* ── 图文介绍里的现场图 —— 原型 `.article-photos` ────────────────────────── */

/* 原型：一列，格间 8px；正文与图之间 12px。 */
.photos {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 24rpx;
}

/* 原型 `.photo-main` 118px 高，`.ph` 72px。 */
.photos__main {
  width: 100%;
  height: 236rpx;
  border-radius: 28rpx;
  background: var(--bg);
}

.photos__row {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.photos__small {
  width: 100%;
  height: 144rpx;
  border-radius: 24rpx;
  background: var(--bg);
}

/* ── 附件下载 —— 原型 `.download-link` ────────────────────────────────────── */

/* 原型：描边行，1fr 44px 两列，行间 8px。 */
.download {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 22rpx;
  border: 1px solid var(--border);
  border-radius: 24rpx;
  background: var(--surface);
}

.download + .download {
  margin-top: 16rpx;
}

.download__name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--fg);
}

.download__act {
  flex: none;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--accent-dark);
}
