/* 党建活动列表页 —— 逐格对着 screens/party-activity-list.html 转写。
 * 换算因子 2，字重按入口页的先例落到 700，卡片外框沿用 .hl-card 的投影。 */

/* 摘要卡 —— 原型 `.summary`，蓝系。 */
.summary {
  padding: 36rpx;
  margin-bottom: 36rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #2563eb, var(--blue), #65b7ff);
  color: #fff;
}

.summary__title {
  font-size: 40rpx;
  font-weight: 700;
}

.summary__desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  opacity: 0.9;
}

/* 原型 `.timeline` 的 gap 是 9px，比学习那张列表松一档。 */
.hl-card + .hl-card {
  margin-top: 18rpx;
}

/* 原型 `.item` 不定高：活动没有第三行字，行高由内容决定。 */
.activity {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 24rpx;
}

.activity__mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  background: var(--blue-light);
  color: var(--blue);
  font-size: 24rpx;
  font-weight: 700;
  flex: none;
}

.activity__text {
  flex: 1;
  min-width: 0;
}

/* 原型 `.title` 一行封顶。 */
.activity__text .hl-card__title {
  display: block;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 28rpx;
  font-weight: 700;
}

.activity__meta {
  display: flex;
  gap: 14rpx;
  overflow: hidden;
  white-space: nowrap;
  font-size: 22rpx;
}
