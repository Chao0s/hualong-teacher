.hl-card + .hl-card {
  margin-top: var(--space-2);
}

/* 原型 `.kicker`：徽章在标题上方自成一行，不与标题争同一行的宽度。 */
.detail__top {
  display: flex;
  align-items: center;
  gap: var(--space-2);
}

.detail__title {
  margin-top: var(--space-2);
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.25;
  color: var(--fg);
}

/* 原型 `.sec` 右侧那句灰色小注：说明这一节能做什么，不是一个可点的东西。 */
.detail__sec {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
}

.detail__sec-hint {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--muted);
}

.detail__notice {
  background: var(--danger-light);
  color: var(--danger);
  font-size: 28rpx;
}

.detail__body {
  font-size: 30rpx;
  line-height: var(--line-cjk);
  white-space: pre-wrap;
}

/* 原型 `.file`：一行材料是同一张卡里的一行，行与行之间一条细线，最后一行不带线。 */
.detail__file {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
  padding: var(--space-2) 0;
}

.detail__file + .detail__file {
  border-top: 1px solid var(--border);
}

.detail__file-name {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.35;
  color: var(--accent-dark);
}

/* 原型 `.action`：材料类型是一枚描边小标，不是正文。 */
.detail__file-usage {
  flex: none;
  padding: 6rpx 18rpx;
  border: 1px solid var(--border);
  border-radius: var(--radius-pill);
  font-size: 22rpx;
  color: var(--muted);
}

.meeting__title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--fg);
}

/* 原型 `.meeting-url`：链接原文印出来，长链接在任意字符处折行。 */
.meeting__url {
  margin-top: var(--space-1);
  font-size: 22rpx;
  line-height: 1.45;
  color: var(--accent-dark);
  word-break: break-all;
}

.meeting__hint {
  margin-top: var(--space-1);
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--muted);
}

.meeting__row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: var(--space-2);
  padding: var(--space-2) var(--space-3);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
}

.meeting__copy {
  color: var(--fg);
  font-size: 26rpx;
  font-weight: 600;
}

/* ── 我的反馈与公开反馈（票据 16）─────────────────────────────────────────── */

.fb__input {
  width: 100%;
  min-height: 200rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--fg);
}

.fb__count {
  margin-top: var(--space-2);
  text-align: right;
  font-size: 24rpx;
  color: var(--muted);
}

.fb__count--over {
  color: var(--danger);
}

/* 预览是把关本身，不是一个提示，所以它比正文更像一张纸：定高、可滚、有结尾。
   读到结尾才解锁确认，短到不需要滚动时平台在渲染后立即触发同一个事件。 */
.fb__preview {
  max-height: 420rpx;
  padding: var(--space-3);
  border-radius: var(--radius);
  background: var(--surface);
}

.fb__preview-text {
  font-size: 28rpx;
  line-height: 1.8;
  color: var(--fg);
  white-space: pre-wrap;
}

.fb__preview-end {
  margin-top: var(--space-3);
  text-align: center;
  font-size: 24rpx;
  color: var(--muted);
}

.fb__reason {
  padding: var(--space-2) 0;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--muted);
}

/* 条件没满足时按钮仍在原地，只是读起来是灰的：挪走它会让教师找不到刚才那个按钮。 */
.fb__btn--off {
  opacity: 0.5;
}

/* 原型 `.feedback`：一条回馈是同一张卡里的一行，行与行之间一条细线。 */
.fb__row {
  padding: var(--space-2) 0;
}

.fb__row + .fb__row {
  border-top: 1px solid var(--border);
}

.fb__who {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
}

.fb__teacher {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--fg);
}

.fb__time {
  font-size: 22rpx;
  color: var(--muted);
}

.fb__said {
  margin-top: var(--space-1);
  font-size: 24rpx;
  line-height: 1.55;
  color: var(--fg);
}
