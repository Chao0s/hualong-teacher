.hl-card + .hl-card {
  margin-top: var(--space-2);
}

.train__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
}

/* 时间是这一页的主信息（票据 14 验收项），所以它比同一行的其余元信息重。 */
.train__time {
  margin-right: var(--space-2);
  color: var(--fg);
  font-weight: 600;
}

.train__excerpt {
  margin-top: var(--space-2);
  font-size: 26rpx;
  color: var(--muted);
  /* 两行足够看出这场讲什么；再多就该点进去读了。 */
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
