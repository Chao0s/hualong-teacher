.hl-card + .hl-card {
  margin-top: var(--space-2);
}

.train__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
}

/* 时间是这一页的主信息（票据 14 验收项），所以它比同一行的其余元信息重。 */
.train__time {
  margin-right: var(--space-2);
  color: var(--fg);
  font-weight: 600;
}

/* 原型 training-list.html 的 `.summary` 用正文色，不是弱化色。 */
.train__excerpt {
  margin-top: var(--space-2);
  font-size: 24rpx;
  line-height: 1.55;
  color: var(--fg);
  /* 两行足够看出这场讲什么；再多就该点进去读了。 */
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

/* ── 我的研修（2026-08-27）───────────────────────────────────────────────── */

/* 原型 `.sec`：16px 粗体。 */
.sec {
  margin: 0 0 20rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--fg);
}

/* 原型 `.foot .pill`：一排描边小标。 */
.train__foot {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.train__pill {
  padding: 8rpx 18rpx;
  border: 1px solid var(--border);
  border-radius: var(--radius-pill);
  font-size: 22rpx;
  color: var(--muted);
}

.more {
  margin-top: var(--space-3);
  padding: var(--space-3);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  background: var(--surface);
  color: var(--accent-dark);
  font-size: 26rpx;
  text-align: center;
}
