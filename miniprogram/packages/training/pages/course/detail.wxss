.hl-card + .hl-card {
  margin-top: var(--space-2);
}

/* 封面用品牌色铺底，与原型 course-building.html 的 article-cover 同一个位置。 */
.cover {
  background: var(--accent);
  color: #fff;
}

.cover__title {
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1.3;
}

.cover__summary {
  margin-top: var(--space-2);
  font-size: 26rpx;
  line-height: var(--line-cjk);
  /* 白底上的 --muted 在品牌色上读不出来，这里用带透明度的白。 */
  color: rgba(255, 255, 255, 0.9);
}

.course__lead {
  font-size: 30rpx;
  line-height: var(--line-cjk);
}

.course__body {
  font-size: 28rpx;
  line-height: var(--line-cjk);
  color: var(--muted);
}

.course__body + .course__item {
  margin-top: var(--space-3);
}

.course__item + .course__item {
  margin-top: var(--space-3);
}
