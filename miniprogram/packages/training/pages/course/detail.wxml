<view class="hl-page" wx:if="{{ready}}">
  <view wx:if="{{errorText}}" class="hl-error">
    {{errorText}}
    <text wx:if="{{errorCanRetry}}" class="hl-error__retry" bindtap="onRetryLoad">重试</text>
    <text wx:if="{{errorRequestId}}" class="hl-error__id">故障码 {{errorRequestId}}</text>
  </view>

  <view wx:if="{{loading}}" class="hl-loading">加载中…</view>

  <block wx:if="{{intro && !loading}}">
    <!-- 原型 course-building.html 的 `.article`：封面与正文在同一张卡里，封面满幅贴边，
         标题不再是一张独立的卡。 -->
    <view class="hl-card course__article">
      <view class="cover">
        <view class="cover__kicker">Course System</view>
        <view class="cover__title">{{intro.intro_title}}</view>
        <view wx:if="{{intro.intro_summary}}" class="cover__summary">{{intro.intro_summary}}</view>
      </view>

      <view class="course__body">
        <view wx:if="{{intro.intro_lead}}" class="course__lead">{{intro.intro_lead}}</view>

        <block wx:for="{{intro.sections}}" wx:for-item="section" wx:key="section_key">
          <view class="course__h2">{{section.section_title}}</view>
          <view wx:if="{{section.section_body}}" class="course__intro">{{section.section_body}}</view>
          <view
            wx:for="{{section.items}}"
            wx:key="item_title"
            class="course__item">
            <view class="course__item-title">{{item.item_title}}</view>
            <view wx:if="{{item.item_body}}" class="course__item-body">{{item.item_body}}</view>
          </view>
        </block>
      </view>
    </view>
  </block>
</view>
