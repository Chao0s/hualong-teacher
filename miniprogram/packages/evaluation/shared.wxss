/**
 * 评价链三页共用的表单、预览与版式样式（票据 20）。
 *
 * 为什么是分包内的一份而不是 app.wxss：这些形状目前只有这三页在用，放进主包会让每一个
 * 客户端都下载它们。分包内共享一份，三页各自 `@import` 它 —— 抄三遍的代价不是行数，
 * 是三处慢慢长歪。与 packages/co-education/shared.wxss 同一条理由。
 *
 * 选择行的尺寸**不在这里**：那一份在 styles/form-rows.wxss，由 app.wxss 统一引入。
 */

/* ── 月份 ────────────────────────────────────────────────────────────────── */

.ev-month__key {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--fg);
}

/* 只读说明用弱化的正文色，不用 --danger：教师改不了月份不是一个错误。 */
.ev-month__hint {
  margin-top: var(--space-1);
  font-size: 26rpx;
  color: var(--muted);
  line-height: var(--line-cjk);
}

/* ── 表单字段 ────────────────────────────────────────────────────────────── */

.ev-field__label {
  font-size: 26rpx;
  color: var(--muted);
}

.ev-textarea {
  width: 100%;
  min-height: 260rpx;
  font-size: 30rpx;
  color: var(--fg);
  line-height: var(--line-cjk);
}

.ev-notice {
  margin-top: var(--space-2);
  font-size: 26rpx;
  color: var(--muted);
  line-height: var(--line-cjk);
}

/* 只读态是**状态**，不是错误：一行理由，不是一个弹窗，颜色也不是红的。 */
.ev-readonly {
  font-size: 28rpx;
  color: var(--muted);
  line-height: var(--line-cjk);
}

.ev-blockers__item {
  margin-top: var(--space-1);
  font-size: 28rpx;
  color: var(--danger);
  line-height: var(--line-cjk);
}

/* ── 预览 ────────────────────────────────────────────────────────────────── */

/* 预览必须能滚到底，`bindscrolltolower` 才有落点 —— 那是「完整预览」的判据本身。 */
.ev-preview {
  max-height: 60vh;
}

.ev-preview__text {
  margin-top: var(--space-2);
  font-size: 30rpx;
  color: var(--fg);
  line-height: var(--line-cjk);
  white-space: pre-wrap;
}

/* ── 五大领域结果（学期评价页的只读区）────────────────────────────────────── */

.ev-domain {
  display: flex;
  justify-content: space-between;
  padding: var(--space-2) 0;
  font-size: 28rpx;
  color: var(--fg);
}

.ev-domain__value {
  font-variant-numeric: tabular-nums;
  color: var(--accent);
}

/* ── A4 版面（综合评估报告页）─────────────────────────────────────────────── */
/*
 * 一页 A4，比例锁在 210 : 297。格子的像素尺寸由 utils/layout 算出来后写进内联样式 ——
 * 这里只负责「这是一张纸」与「盒子不许溢出」。
 *
 * `overflow: hidden` 是承重的：文字再长也只会被这一个框裁住，绝不会流出去压到隔壁的
 * 框上。版式规格 §6.5 要求溢出在结构上不可能，容量由 utils/layout.textCapacity 推导，
 * 超了由页面点名说出来 —— 这一行是最后一道，防的是两者都算漏的情形。
 */
.ev-sheet {
  position: relative;
  width: 100%;
  aspect-ratio: 210 / 297;
  background: #ffffff;
  border-radius: 8rpx;
  overflow: hidden;
}

.ev-sheet__content {
  position: absolute;
}

.ev-widget {
  position: absolute;
  overflow: hidden;
  box-sizing: border-box;
}

.ev-widget__text {
  font-size: 24rpx;
  color: var(--fg);
  line-height: var(--line-cjk);
  white-space: pre-wrap;
}

.ev-widget__title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--fg);
}

.ev-widget__canvas {
  width: 100%;
  height: 100%;
}

/* 版式有问题的一页不画。这一行是那句说明的样式，不是一个错误提示。 */
.ev-sheet__problem {
  margin-top: var(--space-2);
  font-size: 26rpx;
  color: var(--muted);
  line-height: var(--line-cjk);
}

/* ── 成长档案这条链（2026-08-26 按原型建） ─────────────────────────────────── */

/* 分区标题 —— 原型 home-school-common.css 的 `.sec`，六个页面共用。 */
.ev-sec {
  margin: 32rpx 0 20rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--fg);
}

.ev-sec:first-child {
  margin-top: 0;
}

/* 入口按钮行。原型的 `.record-entry-row.three` 与 `.eval-entry-grid`：等宽并排，
 * 只有文字，居中；第一个是主入口，浅绿底加深绿字。 */
.ev-entry-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.ev-entry-row--two {
  grid-template-columns: repeat(2, 1fr);
}

.ev-entry {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 120rpx;
  padding: 24rpx 20rpx;
  border: 1px solid var(--border);
  border-radius: 32rpx;
  background: var(--surface);
  color: var(--fg);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.3;
  text-align: center;
}

/* 原型的主入口用的是绿系（#ecfdf5 底、#047857 字），不是品牌青。照原型。 */
.ev-entry--primary {
  border-color: var(--green-light);
  background: var(--green-light);
  color: var(--green);
}

/* 表格下方那行图例。圆点自己说不出话，这一行就是它的说明。 */
.ev-legend {
  display: flex;
  gap: 24rpx;
  align-items: center;
  margin-top: var(--space-2);
  font-size: 22rpx;
  color: var(--muted);
}

.ev-legend__item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.ev-legend__dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
}

.ev-legend__dot--done { background: var(--green); }
.ev-legend__dot--todo { border: 2rpx solid var(--danger); background: var(--surface); }

/* 计数器。到上限时变红，与 hl-textarea 的既有做法一致。 */
.ev-counter {
  margin-top: var(--space-1);
  font-size: 22rpx;
  color: var(--muted);
  text-align: right;
}

.ev-counter--limit {
  color: var(--danger);
}

/* 一期家长评价的一行 —— 原型 `.list-card`：左侧月份标记、中间标题与统计、右侧箭头。 */
.ev-round {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  /* 原型 home-school-common.css 的 `.list-card` 是裸卡：白底圆角，无描边也无投影。 */
  background: var(--surface);
}

.ev-round + .ev-round {
  margin-top: 20rpx;
}

.ev-round__mark {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 84rpx;
  height: 84rpx;
  border-radius: 26rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.ev-round__mark--0 { color: var(--accent-dark); background: var(--accent-light); }
.ev-round__mark--1 { color: var(--green);       background: var(--green-light); }
.ev-round__mark--2 { color: var(--blue);        background: var(--blue-light); }

.ev-round__body {
  flex: 1;
  min-width: 0;
}

.ev-round__title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--fg);
}

.ev-round__meta {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.ev-round__chev {
  flex: none;
  color: var(--muted);
  font-size: 36rpx;
}

/* 寄语详情的抬头：头像字加姓名与提交时间。 */
.ev-msg-head {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.ev-msg-head__avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 84rpx;
  height: 84rpx;
  border-radius: 26rpx;
  background: var(--accent-light);
  color: var(--accent-dark);
  font-size: 30rpx;
  font-weight: 700;
}

.ev-msg-head__who {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--fg);
}

.ev-msg-head__meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.ev-msg__text {
  margin-top: var(--space-3);
  font-size: 28rpx;
  line-height: var(--line-cjk);
  color: var(--fg);
  white-space: pre-wrap;
}
