/* 上传表单（票据 15）。选择行与横排标签的尺寸在 styles/form-rows.wxss，本页不重写。 */

.hl-card + .hl-card {
  margin-top: var(--space-2);
}

/* 顶部头图 —— 原型 upload-resource.html 的 `.banner`。原型的渐变有三站
 * （#0f766e → accent → #4fc4b9），第三站没有对应令牌，这里用两站。 */
.banner {
  position: relative;
  overflow: hidden;
  padding: 36rpx;
  margin-bottom: 28rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, var(--accent-dark), var(--accent));
  color: #fff;
}

/* 原型右上角那枚白色圆环，压在文字下面。 */
.banner::after {
  content: '';
  position: absolute;
  right: -68rpx;
  top: -76rpx;
  width: 296rpx;
  height: 296rpx;
  border: 40rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 50%;
}

.banner__kicker {
  position: relative;
  z-index: 1;
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: var(--radius-pill);
  background: rgba(255, 255, 255, 0.18);
  font-size: 22rpx;
  font-weight: 600;
}

.banner__title {
  position: relative;
  z-index: 1;
  margin-top: var(--space-3);
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.25;
}

.banner__desc {
  position: relative;
  z-index: 1;
  width: 540rpx;
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.92);
}

/* 区头右侧那句提示 —— 原型 `.section-head` 的 `.hint` 靠右站。 */
.hl-section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.up__aside {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--muted);
}

.up__state {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

/* 驳回原因是这一页最该被读到的一句话，所以它有自己的底色，不混在正文里。 */
.up__reason {
  padding: var(--space-2);
  border-radius: var(--radius-sm);
  background: var(--danger-light);
  color: var(--danger);
  font-size: 26rpx;
  line-height: 1.6;
}

.up__field {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.up__label {
  font-size: 28rpx;
  color: var(--fg);
}

/* 必填星号跟在标签之后，与选择行同一条规则（form-control-spec.md §3）。 */
.up__req {
  color: var(--danger);
}

.up__limit {
  margin-left: var(--space-2);
  font-size: 24rpx;
  color: var(--muted);
}

.up__input {
  min-height: 72rpx;
  font-size: 30rpx;
  color: var(--fg);
}

.up__area {
  width: 100%;
  min-height: 160rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--fg);
}

.up__file {
  display: flex;
  align-items: center;
  gap: var(--space-3);
}

.up__file-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  color: var(--fg);
}

.up__file-note {
  font-size: 26rpx;
  color: var(--muted);
}

.up__file-btn {
  padding: var(--space-1) var(--space-3);
  border-radius: var(--radius-pill);
  background: var(--accent-light);
  color: var(--accent-dark);
  font-size: 26rpx;
}

/* 缺项、超长与文件说明共用一种形态：它们都是「你现在还不能提交，原因是这个」。 */
.up__notice {
  padding: var(--space-2) 0;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--danger);
}

.up__hint {
  padding: var(--space-2) 0;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--muted);
}

/* ── 分节卡与上传目标（2026-08-27 改回原型） ──────────────────────────────── */

/* 原型 `.chunk`：**一节一张卡**，标题与它的字段同在一张白卡里，卡与卡之间隔 10px。
 * 此前是「分区标题浮在底色上、每个字段各一张卡」，那是本仓库自己的排法。 */
.up__chunk {
  padding: 30rpx;
  border-radius: 32rpx;
}

.up__chunk + .up__chunk {
  margin-top: 20rpx;
}

/* 原型 `.section-head`：标题在左，一句提示在右。 */
.up__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.up__sec {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--fg);
}

/* 没有右侧提示时，标题自己要补回那段下边距。 */
.up__sec--solo {
  margin-bottom: 24rpx;
}

.up__hint {
  font-size: 24rpx;
  line-height: 1.45;
  color: var(--muted);
}

/* 原型 `.target-grid`：两张并排的卡，各带字标、名称与一句说明。 */
.up__targets {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.up__target {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  min-height: 164rpx;
  padding: 22rpx;
  border: 1px solid var(--border);
  border-radius: 28rpx;
  background: var(--surface);
}

.up__target--on {
  border-color: var(--accent);
  background: var(--accent-light);
}

.up__target-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  background: var(--accent-light);
  color: var(--accent-dark);
  font-size: 24rpx;
  font-weight: 800;
}

/* 选中时卡底已是浅青，字标再用浅青就糊在一起了，翻成实心。 */
.up__target--on .up__target-mark {
  background: var(--accent);
  color: #fff;
}

.up__target-name {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.2;
}

.up__target-desc {
  font-size: 22rpx;
  line-height: 1.35;
  color: var(--muted);
}

/* ── 上传人信息（只读回显） ───────────────────────────────────────────────── */

/* 原型 `.profile`：姓名与班级两格并排。 */
.up__profile {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.up__field {
  min-width: 0;
}

/* 原型 `.readback`：比输入框更暗的底色，本身就在说「这一格不能填」。
 * `#f2f6f6` 令牌层没有这一档，用页面底色 —— 它在白卡上同样显得凹下去。 */
.up__readback {
  padding: 22rpx 24rpx;
  border: 1px solid var(--border);
  border-radius: 24rpx;
  background: var(--bg);
  color: var(--muted);
  font-size: 26rpx;
  font-weight: 700;
}

.up__note {
  margin-top: 16rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: var(--muted);
}
