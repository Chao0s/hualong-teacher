<view class="hl-page" wx:if="{{ready}}">
  <!-- 三个维度都是横排标签（form-control-spec.md §2.1）。年级与领域单选 ≤6 项命中
       第 2 问；活动形式的列是多选数组，命中第 1 问。一个滚轮也没有。
       三行标签装在一张 `.filter-panel` 卡里，与原型 case-library.html 同形：三行
       松散地浮在背景上时，看不出它们是同一组筛选。 -->
  <view class="filter-panel">
    <view class="hl-chips">
      <view class="hl-chips__label">年级</view>
      <view
        wx:for="{{gradeOptions}}"
        wx:key="key"
        class="hl-chips__item {{item.key === filters.case_grade ? 'hl-chips__item--on' : ''}}"
        data-field="case_grade"
        data-key="{{item.key}}"
        bindtap="onFilterTap">{{item.label}}</view>
    </view>

    <view class="hl-chips">
      <view class="hl-chips__label">五大领域</view>
      <view
        wx:for="{{fieldOptions}}"
        wx:key="key"
        class="hl-chips__item {{item.key === filters.case_field ? 'hl-chips__item--on' : ''}}"
        data-field="case_field"
        data-key="{{item.key}}"
        bindtap="onFilterTap">{{item.label}}</view>
    </view>

    <view class="hl-chips">
      <view class="hl-chips__label">活动形式</view>
      <view
        wx:for="{{areaOptions}}"
        wx:key="key"
        class="hl-chips__item {{item.key === filters.case_area ? 'hl-chips__item--on' : ''}}"
        data-field="case_area"
        data-key="{{item.key}}"
        bindtap="onFilterTap">{{item.label}}</view>
    </view>
  </view>

  <!-- 上传案例。票据 15 的两个入口之一，另一个是首页的「待上传」待办。 -->
  <view class="hl-btn hl-btn--block" bindtap="onUploadTap">上传课程案例</view>

  <view wx:if="{{errorText}}" class="hl-error">
    {{errorText}}
    <text wx:if="{{errorCanRetry}}" class="hl-error__retry" bindtap="onRetryList">重试</text>
    <text wx:if="{{errorRequestId}}" class="hl-error__id">故障码 {{errorRequestId}}</text>
  </view>

  <view wx:if="{{loadingFirst}}" class="hl-loading">加载中…</view>

  <block wx:if="{{!loadingFirst}}">
    <!-- 空与失败是两种状态：读失败时不说「暂无」，那是把读不到说成没有东西可读。 -->
    <view wx:if="{{items.length === 0 && !errorText}}" class="hl-card hl-empty">
      当前筛选暂无案例，换一个年级、领域或活动形式再看
    </view>

    <view
      wx:for="{{items}}"
      wx:key="case_id"
      class="hl-card kase"
      data-id="{{item.case_id}}"
      data-status="{{item.case_status}}"
      bindtap="onTap">
      <view class="kase__thumb">{{item.thumb_label}}</view>
      <view class="kase__body">
        <view class="kase__top">
          <text class="hl-card__title">{{item.case_name}}</text>
          <text wx:if="{{item.status_label}}" class="hl-pill {{item.status_pill}}">{{item.status_label}}</text>
        </view>
        <view wx:if="{{item.tag_label}}" class="hl-card__meta">{{item.tag_label}}</view>
        <view wx:if="{{item.excerpt}}" class="kase__excerpt">{{item.excerpt}}</view>
      </view>
    </view>

    <view wx:if="{{loadingMore}}" class="hl-loading">加载更多…</view>
    <view wx:if="{{exhausted && items.length > 0}}" class="hl-loading">没有更多了</view>
  </block>
</view>
