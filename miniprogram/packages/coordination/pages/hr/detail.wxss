/* 正文卡 —— 原型 coordination-file-list.html 的 `.preview`。 */

.detail__title {
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.35;
  color: var(--fg);
}

/* 原型 `.preview-meta`：12px 灰字，与标题隔 8px。原型各段之间用点号分隔，这里用
 * 间距分隔，因为每一段都可能空着。 */
.detail__meta {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  margin-top: var(--space-2);
  font-size: 24rpx;
  color: var(--muted);
}

/* 原型 `.preview-body` 的上边框，上下各留 14px；取最接近的 --space-3（24rpx）。 */
.detail__rule {
  margin: var(--space-3) 0;
}

/* 原型正文 13px，行高 1.75，字色 #343330；取最接近的令牌 --fg。 */
.detail__body {
  font-size: 26rpx;
  line-height: var(--line-cjk);
  color: var(--fg);
  white-space: pre-wrap;
}

/* 原型 `.attachment-title`：13px 粗体，上方留 16px。 */
.detail__files-title {
  margin-top: var(--space-4);
  margin-bottom: var(--space-2);
  font-size: 26rpx;
  font-weight: 800;
  color: var(--fg);
}

/* 原型 `.attachment-row`：描边窄行，圆角 10px，内边距 10px，行内 12px 字。 */
.detail__file {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx;
  border: 1px solid var(--border);
  border-radius: 20rpx;
  font-size: 24rpx;
  color: var(--fg);
}

.detail__file + .detail__file {
  margin-top: var(--space-2);
}

.detail__open {
  flex-shrink: 0;
  color: var(--accent-dark);
  font-weight: 800;
}
