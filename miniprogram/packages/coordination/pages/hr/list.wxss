.cat {
  display: flex;
  gap: var(--space-2);
  padding-bottom: var(--space-3);
}

.cat__item {
  padding: var(--space-1) var(--space-3);
  border-radius: var(--radius-pill);
  background: var(--surface);
  color: var(--muted);
  font-size: 28rpx;
}

.cat__item--on {
  background: var(--accent-light);
  color: var(--accent-dark);
  font-weight: 600;
}

.hl-card + .hl-card {
  margin-top: var(--space-2);
}

.doc__meta {
  display: flex;
  gap: var(--space-2);
}

.doc__excerpt {
  margin-top: var(--space-2);
  font-size: 26rpx;
  color: var(--muted);
  /* 两行足够看出这条讲什么；再多就该点进去读了。 */
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
