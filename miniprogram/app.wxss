/* 设计令牌 —— 逐条抄自设计稿 home.html 的 `:root`。
 * 网页版的 `:root` 在小程序里对应 `page`。 */
page {
  --bg: #f0f5f5;
  --surface: #ffffff;
  --fg: #1a1916;
  --muted: #868686;
  --border: #e0e8e8;
  --accent: #189b91;
  --accent-dark: #067e76;
  --accent-light: #e8f5f4;
  --green: #4b9a5a;
  --green-light: #eaf5ed;
  --amber: #feaf06;
  --amber-light: #fff6df;
  --orange: #f6762f;
  --orange-light: #fff0e8;
  --blue: #3388fc;
  --blue-light: #e8f2fe;
  --danger: #dc2626;
  --danger-light: #feecec;
  --purple: #7c5cff;
  --purple-light: #f0edff;
  --radius: 28rpx;
  --radius-sm: 18rpx;

  background: var(--bg);
  color: var(--fg);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', system-ui, sans-serif;
  -webkit-font-smoothing: antialiased;
}

/*
 * `width: 100%` 的控件必须一并算上内边距与边框，否则会宽出容器。
 *
 * **`input`／`textarea`／`picker` 原来不在这张表里** —— 它们是原生表单标签，
 * 不是 `view`。于是 `.input`／`.textarea` 那条规则（宽 100% + 内边距 24rpx +
 * 边框）实际宽度是 100% 再加两边，边框整条溢出到卡片外面。
 * 边框还是 1rpx 时溢出量小、看不太出来；改成 2rpx 之后就明显了。
 *
 * 发布家长测评、填写月度评价、填写学期评价、教师寄语、发布新任务五处都是这一条。
 */
view, text, image,
input, textarea, picker {
  box-sizing: border-box;
}
