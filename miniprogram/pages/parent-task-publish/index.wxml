<!-- 发布新任务 —— 对照原型 screens/parent-task-publish.html。
     切换任务类型会把三个输入框整套换成该类型的示例文案，和原型一致。 -->
<view class="page">

  <view class="sec sec--first">任务类型</view>
  <view class="chunk">
    <view class="task-type-grid">
      <view
        class="task-type {{type === item.key ? 'task-type--active' : ''}}"
        wx:for="{{types}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="onTypeTap"
      >
        <text class="task-type__title">{{item.title}}</text>
        <text class="task-type__desc">{{item.desc}}</text>
      </view>
    </view>
  </view>

  <view class="sec">任务信息</view>
  <view class="chunk">
    <text class="form-label form-label--first">任务名称</text>
    <input class="input" maxlength="100" value="{{form.title}}" data-key="title" bindinput="onInput" />

    <text class="form-label">任务背景</text>
    <textarea class="textarea" maxlength="500" value="{{form.background}}" data-key="background" bindinput="onInput" />

    <text class="form-label">任务详情</text>
    <textarea class="textarea" maxlength="1000" value="{{form.detail}}" data-key="detail" bindinput="onInput" />

    <view class="btn btn--green sticky-action" hover-class="btn--hover" bindtap="onSubmit">{{submitText}}</view>
    <view class="submit-note" wx:if="{{noteShown}}">已生成任务草稿，可在发布前继续调整。</view>
  </view>

</view>
