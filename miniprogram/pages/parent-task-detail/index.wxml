<!-- 亲子任务 · 任务详情 —— 数据来自 GET /home-school/parent-tasks/{id} 与 …/submissions。

     表格三列：幼儿 / 已读 / 完成情况。
     「已读」F24 之后有落点了；「提交预览」仍没有数据源（G70），不渲染。
     提交时间那一列拿掉了 —— 完成情况已经说明了交没交，精确到分钟对教师没有用。

     任务时间只显示到日：教师挑 15:00 还是 15:30 对家长没有区别，
     库里存的仍是完整时刻（start_at 是 TIMESTAMP，在 §1.2 的计划时刻白名单上）。 -->
<view class="page">

  <view class="hint" wx:if="{{loading}}">正在加载任务…</view>
  <view class="hint" wx:elif="{{error}}" bindtap="onRetry">{{error}}　点此重试</view>

  <block wx:if="{{task}}">
    <view class="chunk">
      <text class="pill">{{task.typeLabel}}任务 · {{task.statusLabel}}</text>
      <text class="task-title">{{task.title}}</text>

      <view class="task-field" wx:if="{{task.background}}">
        <text class="task-field__label">任务背景</text>
        <text class="task-field__text">{{task.background}}</text>
      </view>
      <view class="task-field">
        <text class="task-field__label">任务详情</text>
        <text class="task-field__text">{{task.detail}}</text>
      </view>
      <view class="task-field">
        <text class="task-field__label">时间</text>
        <text class="task-field__text">
          {{task.startDayLabel}} 开始{{task.hasDue ? '，' + task.dueDayLabel + ' 截止' : '，不设截止'}}
        </text>
      </view>

      <view class="metric-row metric-row--gap">
        <view class="metric" wx:for="{{metrics}}" wx:key="label">
          <text class="metric__n">{{item.value}}</text>
          <text class="metric__l">{{item.label}}</text>
        </view>
      </view>
      <view class="progress-line">
        <view class="bar"><view class="bar__fill" style="width: {{rate}}%"></view></view>
        <text class="status status--done">{{rate}}%</text>
      </view>
      <text class="task-note">「班级人数」是目前班上在园的幼儿数，不是发布当时的名册。</text>
    </view>

    <view class="sec">家长提交情况</view>
    <view class="table-wrap">
      <view class="prog-row prog-row--head">
        <text class="prog-cell prog-cell--name">幼儿</text>
        <text class="prog-cell">已读</text>
        <text class="prog-cell">完成情况</text>
      </view>
      <view class="prog-row" wx:for="{{rows}}" wx:key="childId" wx:for-item="row">
        <text class="prog-cell prog-cell--name">{{row.name}}</text>
        <view class="prog-cell"><text class="status status--{{row.readTone}}">{{row.readLabel}}</text></view>
        <view class="prog-cell"><text class="status status--{{row.doneTone}}">{{row.doneLabel}}</text></view>
      </view>
    </view>

    <view
      class="btn btn--ghost task-close"
      wx:if="{{task.can.close}}"
      hover-class="btn--hover"
      bindtap="onClose"
    >{{closing ? '正在结束…' : '结束任务'}}</view>
    <text class="task-note" wx:elif="{{task.closed}}">这个任务已经结束，不能重新开启。</text>
  </block>

</view>
