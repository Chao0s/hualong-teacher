@import '/styles/home-school-common.wxss';

/* 亲子任务 · 任务详情 —— 原型没有自己的样式块，除表格列宽外都用共用样式。 */

.page {
  padding: 24rpx 32rpx 56rpx;
}

.metric-row--gap {
  margin-top: 28rpx;
}

/* 三列：幼儿 / 已读 / 完成情况。
   「提交预览」没有数据源（G70），不渲染；提交时间那一列拿掉了 ——
   完成情况已经说明了交没交。 */
.prog-row {
  grid-template-columns: 1.2fr 1fr 1.2fr;
}

.prog-cell {
  padding: 20rpx 8rpx;
  font-size: 22rpx;
}

.prog-cell--name {
  padding-left: 16rpx;
}

.task-title {
  display: block;
  margin-top: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.4;
}

.task-field {
  margin-top: 24rpx;
}

.task-field__label {
  display: block;
  color: var(--muted);
  font-size: 22rpx;
}

.task-field__text {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

.task-note {
  display: block;
  margin-top: 20rpx;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.5;
}

.task-close {
  margin-top: 32rpx;
}
