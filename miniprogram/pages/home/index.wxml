<view class="hl-page" wx:if="{{ready}}">

  <view class="head">
    <view class="head__hello">{{teacherName || '老师'}}，你好</view>
    <view class="head__meta">
      <text wx:if="{{className}}">{{className}}</text>
      <text wx:if="{{termName}}" class="head__term">{{termName}}</text>
    </view>
    <view wx:if="{{noTerm}}" class="head__noterm">{{termNotice}}</view>
  </view>

  <view wx:if="{{errorText}}" class="hl-error">
    {{errorText}}
    <text wx:if="{{errorCanRetry}}" class="hl-error__retry" bindtap="onRetryLoad">重试</text>
    <text wx:if="{{errorRequestId}}" class="hl-error__id">故障码 {{errorRequestId}}</text>
  </view>

  <view class="hl-loading" wx:if="{{loading}}">加载中…</view>

  <!-- 空与失败是两种状态：读失败时四个区都不说「暂无」，那是在替服务器撒谎。 -->
  <block wx:if="{{!loading}}">

    <view class="hl-section-title">
      待办事项
      <text wx:if="{{todoCount > 0}}" class="hl-pill hl-pill--pending">待处理 {{todoCount}}</text>
    </view>
    <view wx:if="{{todos.length === 0 && !errorText}}" class="hl-card hl-empty">暂无待办</view>
    <view wx:for="{{todos}}" wx:key="todo_id" class="hl-card todo" data-kind="{{item.todo_kind}}" bindtap="onTodoTap">
      <view class="todo__row">
        <text class="hl-card__title">{{item.todo_title}}</text>
        <text class="hl-pill {{item.pill_class}}">{{item.kind_label}}</text>
      </view>
      <view wx:if="{{item.due_label}}" class="hl-card__meta">截止 {{item.due_label}}</view>
    </view>

    <view class="hl-section-title">
      资源中心通知
      <text class="more" bindtap="onNoticeMore">全部</text>
    </view>
    <view wx:if="{{notices.length === 0 && !errorText}}" class="hl-card hl-empty">暂无通知</view>
    <view
      wx:for="{{notices}}"
      wx:key="notice_id"
      class="hl-card notice-row"
      data-id="{{item.notice_id}}"
      bindtap="onNoticeTap">
      <view class="notice-row__text">
        <text class="hl-card__title">{{item.notice_title}}</text>
        <view class="hl-card__meta">{{item.published_label}}</view>
      </view>
      <hl-icon name="icon-10" color="muted" size="32rpx" />
    </view>

    <view class="hl-section-title">常用入口</view>
    <view class="quick">
      <view
        wx:for="{{quickEntries}}"
        wx:key="key"
        class="quick__item {{item.disabled ? 'quick__item--off' : ''}}"
        data-key="{{item.key}}"
        bindtap="onQuickTap">
        <hl-icon name="{{item.icon}}" color="{{item.color}}" size="52rpx" />
        <text class="quick__label">{{item.label}}</text>
      </view>
    </view>

    <view class="hl-section-title">
      推荐课程案例
      <text class="more" bindtap="onCaseMore">全部案例</text>
    </view>
    <view wx:if="{{cases.length === 0 && !errorText}}" class="hl-card hl-empty">暂无推荐</view>
    <view wx:if="{{cases.length > 0}}" class="cases">
      <view
        wx:for="{{cases}}"
        wx:key="case_id"
        class="hl-card case"
        data-id="{{item.case_id}}"
        bindtap="onCaseTap">
        <view class="case__thumb">{{item.thumb_label}}</view>
        <view class="case__name">{{item.case_name}}</view>
        <view wx:if="{{item.tag_label}}" class="hl-card__meta">{{item.tag_label}}</view>
      </view>
    </view>

  </block>
</view>
