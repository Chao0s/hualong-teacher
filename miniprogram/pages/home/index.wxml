<view class="hl-page" wx:if="{{ready}}">

  <!-- 原型 home.html 顶部那块 `.banner-img.b1` 渐变头图，标题与副标题照原型
       （2026-08-26 改版拍板补回）。票据 08 要求一眼看到姓名、班级与学期 —— 两者
       占同一格，所以是同一块头图多一行身份，不是并排放两个页头。 -->
  <view class="head">
    <view class="head__hello">教师工作台</view>
    <view class="head__sub">上传资源、处理待办任务</view>
    <view class="head__meta">
      <text>{{teacherName || '老师'}}</text>
      <text wx:if="{{className}}" class="head__term">{{className}}</text>
      <text wx:if="{{termName}}" class="head__term">{{termName}}</text>
    </view>
  </view>
  <view wx:if="{{noTerm}}" class="head__noterm">{{termNotice}}</view>

  <view wx:if="{{errorText}}" class="hl-error">
    {{errorText}}
    <text wx:if="{{errorCanRetry}}" class="hl-error__retry" bindtap="onRetryLoad">重试</text>
    <text wx:if="{{errorRequestId}}" class="hl-error__id">故障码 {{errorRequestId}}</text>
  </view>

  <view class="hl-loading" wx:if="{{loading}}">加载中…</view>

  <!-- 空与失败是两种状态：读失败时四个区都不说「暂无」，那是在替服务器撒谎。 -->
  <block wx:if="{{!loading}}">

    <!-- 待办事项 —— 原型的三张统计卡（传／办／评），2026-08-26 改版恢复。三张卡
         恒在：数字为 0 也照样显示「待处理 0」（01 home-spec.md 90 行）。 -->
    <view class="hl-section-title">待办事项</view>
    <view wx:if="{{stats.length > 0}}" class="stats">
      <view
        wx:for="{{stats}}"
        wx:key="key"
        class="hl-card stat"
        data-kind="{{item.key}}"
        bindtap="onTodoTap">
        <view class="stat__mark stat__mark--{{item.key}}">{{item.mark}}</view>
        <view class="stat__title">{{item.title}}</view>
        <view class="stat__badge {{item.badge_class}}">{{item.badge}}</view>
      </view>
    </view>

    <view class="hl-section-title">常用入口</view>
    <view class="quick">
      <view
        wx:for="{{quickEntries}}"
        wx:key="key"
        class="quick__item {{item.disabled ? 'quick__item--off' : ''}}"
        data-key="{{item.key}}"
        bindtap="onQuickTap">
        <!-- 原型的 `.quick-icon`：图标坐在一块与自身色调同族的圆角底色上。
             通知卡带未读角标 —— 资源中心通知自此从一节变一卡，未读数还在。 -->
        <view class="quick__icon quick__icon--{{item.color}}">
          <hl-icon name="{{item.icon}}" color="{{item.color}}" size="44rpx" />
          <view wx:if="{{item.key === 'notice' && unreadNotice > 0}}" class="quick__unread">{{unreadNotice}}</view>
        </view>
        <text class="quick__label">{{item.label}}</text>
      </view>
    </view>

    <view class="hl-section-title">
      推荐课程案例
      <text class="more" bindtap="onCaseMore">全部案例</text>
    </view>
    <view wx:if="{{cases.length === 0 && !errorText}}" class="hl-card hl-empty">暂无推荐</view>
    <view wx:if="{{cases.length > 0}}" class="cases">
      <view
        wx:for="{{cases}}"
        wx:key="case_id"
        class="hl-card case"
        data-id="{{item.case_id}}"
        bindtap="onCaseTap">
        <view class="case__thumb">{{item.thumb_label}}</view>
        <view class="case__name">{{item.case_name}}</view>
        <view wx:if="{{item.tag_label}}" class="hl-card__meta">{{item.tag_label}}</view>
      </view>
    </view>

  </block>
</view>
