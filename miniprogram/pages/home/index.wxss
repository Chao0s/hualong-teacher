/* 渐变头图 —— 原型 home.html 的 `.banner-img.b1`：150px 高、16px 圆角、内容压在
 * 底部、白字。原型的渐变有三站（accent-dark → accent → #45bfb5），第三站没有对应
 * 令牌，这里用两站，缺的浅青记在报告里。 */
.head {
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  min-height: 300rpx;
  padding: 40rpx 48rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, var(--accent-dark), var(--accent));
  color: #fff;
}

.head__hello {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}

/* 原型 `.banner-sub`：12px、不加粗、0.88 不透明度。 */
.head__sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 400;
  color: rgba(255, 255, 255, 0.88);
}

.head__meta {
  margin-top: var(--space-1);
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.88);
}

.head__term {
  margin-left: var(--space-2);
}

/* 假期说明移出头图：琥珀色的说明卡压在青色渐变上读不出来。 */
.head__noterm {
  margin-top: var(--space-2);
  padding: var(--space-2);
  border-radius: var(--radius-sm);
  background: var(--amber-light);
  color: #8a5c00;
  font-size: 26rpx;
}

.hl-section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.more {
  font-size: 26rpx;
  font-weight: 400;
  color: var(--accent);
}

.hl-card + .hl-card {
  margin-top: var(--space-2);
}

/* 待办事项的三张统计卡 —— 原型 `.todo-cards`／`.todo-card`／`.dot-icon`／
 * `.todo-badge`，rpx 一律按票据 01 的粗因子 2 换算。角标文字色 #a15d00 与
 * #226ac7 是原型字面量（state-warn / state-info），令牌表里没有对应项。 */
.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

/* 首页族的卡**既没有描边也没有投影**（原型 `.todo-card`／`.quick-item`／
 * `.resource-card` 三者都只有白底与圆角）。二级页的卡才有那条 1px 描边，
 * 所以这里把 `hl-card` 的描边撤掉 —— 撤的是描边，不是把投影加回来。 */
.stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
  min-height: 224rpx;
  padding: 30rpx 16rpx 26rpx;
  border: none;
  border-radius: 32rpx;
  text-align: center;
}

/* 网格里的相邻卡片不再堆叠（与 .cases 同一条理由）。 */
.stats .hl-card + .hl-card {
  margin-top: 0;
}

.stat__mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  border-radius: 22rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.stat__mark--upload     { color: var(--accent-dark); background: var(--accent-light); }
.stat__mark--task       { color: #a15d00; background: var(--amber-light); }
.stat__mark--assessment { color: var(--blue); background: var(--blue-light); }

.stat__title {
  font-size: 27rpx;
  font-weight: 700;
}

.stat__badge {
  margin-top: auto;
  padding: 6rpx 18rpx;
  border-radius: var(--radius-pill);
  font-size: 21rpx;
  font-weight: 700;
  color: var(--accent-dark);
  background: var(--accent-light);
  white-space: nowrap;
}

.stat__badge--warn { color: #a15d00; background: var(--amber-light); }
.stat__badge--info { color: #226ac7; background: var(--blue-light); }

/* 常用入口：原型是 `repeat(4, 1fr)` 的一行四格，不是两列。 */
.quick {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--space-2);
}

.quick__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-2);
  padding: 30rpx 8rpx;
  border-radius: var(--radius);
  background: var(--surface);
  text-align: center;
  color: var(--fg);
}

.quick__icon {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
}

/* 通知卡的未读角标：未读为 0 时整个节点不渲染，不是渲染一个 0。 */
.quick__unread {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: var(--radius-pill);
  background: var(--danger);
  color: #fff;
  font-size: 20rpx;
  line-height: 32rpx;
  text-align: center;
}

.quick__icon--accent { background: var(--accent-light); }
.quick__icon--green  { background: var(--green-light); }
.quick__icon--amber  { background: var(--amber-light); }
.quick__icon--blue   { background: var(--blue-light); }

.quick__label {
  font-size: 24rpx;
  font-weight: 600;
  white-space: nowrap;
}

/* A write entry during the holiday: visibly off, and the tap explains why. */
.quick__item--off {
  color: var(--muted);
  background: var(--bg);
  box-shadow: none;
}

/* 推荐课程案例：原型的 `.resource-grid` 是三列网格，卡片高 92px，缩略图是一枚
 * 30px 的小方块坐在左上角，不是一条通栏的色带。 */
.cases {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx;
}

/* 同上：原型 `.resource-card` 没有描边。 */
.case {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
  min-height: 184rpx;
  padding: 20rpx 16rpx;
  border: none;
}

.case__thumb {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  border-radius: 20rpx;
  background: var(--accent-light);
  color: var(--accent-dark);
  font-size: 26rpx;
  font-weight: 600;
}

/* 原型按位置换色：第一张青、第二张绿、第三张琥珀。 */
.case:nth-child(2) .case__thumb {
  background: var(--green-light);
  color: var(--green);
}

.case:nth-child(3) .case__thumb {
  background: var(--amber-light);
  color: #8a5c00;
}

.case__name {
  margin-top: var(--space-1);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.25;
  color: var(--fg);
}

/* 网格里的相邻卡片不再堆叠，所以列表用的那条 margin-top 要在这里撤掉，
   否则第二、三张卡会比第一张低一截。 */
.cases .hl-card + .hl-card {
  margin-top: 0;
}

.case .hl-card__meta {
  margin-top: 0;
  font-size: 20rpx;
}
