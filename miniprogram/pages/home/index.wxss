/* 首页样式 —— 逐条对照原型 screens/home.html 的内联 CSS。
 *
 * 单位换算：原型视口宽 390px，本工程沿用 miniprogram/ 现有工程的口径，
 * 1px 记 2rpx（例如 `padding: 0 16px` → `0 32rpx`，头图 `150px` → `300rpx`）。
 * 底部导航在 components/hl-tabbar 里，这里不再重复。 */

.page {
  /* 原型 `.scroll { padding: 0 16px 80px }`。
   * 顶部补 24rpx：原型的标题栏自带 12px 下内边距，微信原生标题栏没有。 */
  padding: 24rpx 32rpx calc(200rpx + env(safe-area-inset-bottom));
}

/* ── 头图 ──────────────────────────────────────────────────────────────── */

/* 原型 `.banner-img.b1`：150px 高、16px 圆角、内容压底、白字，三站渐变。 */
.banner {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: flex-end;
  height: 300rpx;
  padding: 40rpx 48rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #067e76, #189b91, #45bfb5);
  overflow: hidden;
}

.banner__title {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}

.banner__sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 400;
  color: rgba(255, 255, 255, 0.88);
}

/* ── 分组标题 ──────────────────────────────────────────────────────────── */

/* 原型 `.sec`：16px、650 字重、上下 22px/12px。 */
.sec {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 44rpx 0 24rpx;
}

.sec__title {
  font-size: 32rpx;
  font-weight: 600;
}

/* 原型 `.section-more`。 */
.sec__more {
  padding: 8rpx 0;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--accent-dark);
}

/* ── 近期任务 ──────────────────────────────────────────────────────────── */

.todo-cards {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.todo-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  gap: 18rpx;
  min-height: 224rpx;
  padding: 30rpx 16rpx 26rpx;
  border-radius: 32rpx;
  background: var(--surface);
  text-align: center;
}

.todo-card--hover {
  background: #f8fbfb;
  transform: scale(0.985);
}

.todo-title {
  font-size: 27rpx;
  font-weight: 700;
  letter-spacing: 0.4rpx;
}

/* `margin-top: auto` 把徽标压到卡片底部，与原型一致。 */
.todo-badge {
  margin-top: auto;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 700;
  white-space: nowrap;
}

/* 原型里第一张卡不带状态类，配色落在 `.todo-badge` 基类上。
 * 这里三张卡一律由 tone 决定，读起来一致，也免得基类藏一份默认色。 */
.todo-badge--accent {
  color: var(--accent-dark);
  background: var(--accent-light);
}

.todo-badge--warn {
  color: #a15d00;
  background: var(--amber-light);
}

.todo-badge--info {
  color: #226ac7;
  background: var(--blue-light);
}

/* 原型 `.dot-icon`：34px 方块、11px 圆角、单个汉字。 */
.dot-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  border-radius: 22rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.dot-icon--upload {
  color: var(--accent-dark);
  background: var(--accent-light);
}

.dot-icon--task {
  color: #a15d00;
  background: var(--amber-light);
}

.dot-icon--assess {
  color: var(--blue);
  background: var(--blue-light);
}

/* ── 常用入口 ──────────────────────────────────────────────────────────── */

.quick-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
}

.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 30rpx 8rpx;
  border-radius: var(--radius);
  background: var(--surface);
}

.quick-item--hover {
  background: #f8fbfb;
}

/* 原型 `.quick-icon`：44px 方块、14px 圆角，内含 22px 线性图标。
 * 小程序 wxml 没有 <svg>，图标改用 base64 背景图，见文件末尾。 */
.quick-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 44rpx 44rpx;
}

.quick-label {
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
  white-space: nowrap;
}

/* ── 推荐课程案例 ──────────────────────────────────────────────────────── */

.resource-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx;
}

.resource-card {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 184rpx;
  padding: 20rpx 16rpx;
  border-radius: 28rpx;
  background: var(--surface);
}

.resource-card--hover {
  background: #f8fbfb;
}

/* 原型按 nth-child 给缩略图配色；这里改由数据里的 tone 决定，读起来更直白。 */
.resource-thumb {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  font-weight: 800;
}

.resource-thumb--accent {
  color: var(--accent-dark);
  background: var(--accent-light);
}

.resource-thumb--green {
  color: var(--green);
  background: var(--green-light);
}

.resource-thumb--amber {
  color: #c47900;
  background: var(--amber-light);
}

.resource-name {
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.25;
}

.resource-tag {
  font-size: 20rpx;
  color: var(--muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

