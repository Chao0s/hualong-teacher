/* 渐变头图 —— 原型 home.html 的 `.banner-img.b1`：150px 高、16px 圆角、内容压在
 * 底部、白字。原型的渐变有三站（accent-dark → accent → #45bfb5），第三站没有对应
 * 令牌，这里用两站，缺的浅青记在报告里。 */
.head {
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  min-height: 300rpx;
  padding: 40rpx 48rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, var(--accent-dark), var(--accent));
  color: #fff;
}

.head__hello {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}

.head__meta {
  margin-top: var(--space-1);
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.88);
}

.head__term {
  margin-left: var(--space-2);
}

/* 假期说明移出头图：琥珀色的说明卡压在青色渐变上读不出来。 */
.head__noterm {
  margin-top: var(--space-2);
  padding: var(--space-2);
  border-radius: var(--radius-sm);
  background: var(--amber-light);
  color: #8a5c00;
  font-size: 26rpx;
}

.hl-section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.more {
  font-size: 26rpx;
  font-weight: 400;
  color: var(--accent);
}

.hl-card + .hl-card {
  margin-top: var(--space-2);
}

.todo__row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-2);
}

/* 常用入口：原型是 `repeat(4, 1fr)` 的一行四格，不是两列。 */
.quick {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--space-2);
}

.quick__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-2);
  padding: 30rpx 8rpx;
  border-radius: var(--radius);
  background: var(--surface);
  box-shadow: var(--shadow-soft);
  text-align: center;
  color: var(--fg);
}

.quick__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
}

.quick__icon--accent { background: var(--accent-light); }
.quick__icon--green  { background: var(--green-light); }
.quick__icon--amber  { background: var(--amber-light); }
.quick__icon--blue   { background: var(--blue-light); }

.quick__label {
  font-size: 24rpx;
  font-weight: 600;
  white-space: nowrap;
}

/* A notice row keeps its chevron at the trailing edge. */
.notice-row {
  display: flex;
  align-items: center;
  gap: var(--space-2);
}

.notice-row__text {
  flex: 1;
  min-width: 0;
}

/* A write entry during the holiday: visibly off, and the tap explains why. */
.quick__item--off {
  color: var(--muted);
  background: var(--bg);
  box-shadow: none;
}

/* 推荐课程案例：原型的 `.resource-grid` 是三列网格，卡片高 92px，缩略图是一枚
 * 30px 的小方块坐在左上角，不是一条通栏的色带。 */
.cases {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx;
}

.case {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
  min-height: 184rpx;
  padding: 20rpx 16rpx;
}

.case__thumb {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  border-radius: 20rpx;
  background: var(--accent-light);
  color: var(--accent-dark);
  font-size: 26rpx;
  font-weight: 600;
}

/* 原型按位置换色：第一张青、第二张绿、第三张琥珀。 */
.case:nth-child(2) .case__thumb {
  background: var(--green-light);
  color: var(--green);
}

.case:nth-child(3) .case__thumb {
  background: var(--amber-light);
  color: #8a5c00;
}

.case__name {
  margin-top: var(--space-1);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.25;
  color: var(--fg);
}

/* 网格里的相邻卡片不再堆叠，所以列表用的那条 margin-top 要在这里撤掉，
   否则第二、三张卡会比第一张低一截。 */
.cases .hl-card + .hl-card {
  margin-top: 0;
}

.case .hl-card__meta {
  margin-top: 0;
  font-size: 20rpx;
}
