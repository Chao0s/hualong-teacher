/* 发起方：原型的 `.kicker`，一枚青色药丸。 */
.detail__kicker {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: var(--radius-pill);
  background: var(--accent-light);
  color: var(--accent-dark);
  font-size: 22rpx;
  font-weight: 600;
}

.detail__title {
  margin-top: var(--space-2);
  font-size: 38rpx;
  font-weight: 600;
  color: var(--fg);
}

.detail__row {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  margin-top: var(--space-2);
}

.detail__intro,
.detail__division {
  font-size: 28rpx;
  color: var(--fg);
  line-height: var(--line-cjk);
}

.detail__intro {
  margin-top: var(--space-2);
  color: var(--muted);
}

.detail__file + .detail__file {
  margin-top: var(--space-2);
}

/* 提交区 —— 原型的 `.submit-card`：虚线青框、青色底、说明在上、按钮在下。 */
.submit-card {
  margin-top: var(--space-4);
  padding: var(--space-3);
  border: 1px dashed var(--accent);
  border-radius: var(--radius-sm);
  background: var(--accent-light);
}

.submit-card__title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--fg);
}

.submit-card__desc {
  margin-top: var(--space-1);
  font-size: 24rpx;
  line-height: 1.45;
  color: var(--muted);
}

.submit {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  margin-top: var(--space-2);
  border-radius: var(--radius-sm);
  background: var(--accent);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
}

/* 关闭或假期：看得出不可用，理由写在下一行，不靠点击才说。 */
.submit--off {
  background: var(--border);
  color: var(--muted);
}

.submit__reason {
  margin-top: var(--space-2);
  text-align: center;
  font-size: 24rpx;
  color: var(--muted);
}
