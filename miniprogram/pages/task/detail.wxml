<view class="hl-page" wx:if="{{ready}}">

  <view wx:if="{{errorText}}" class="hl-error">
    {{errorText}}
    <text wx:if="{{errorCanRetry}}" class="hl-error__retry" bindtap="onRetryLoad">重试</text>
    <text wx:if="{{errorRequestId}}" class="hl-error__id">故障码 {{errorRequestId}}</text>
  </view>

  <view wx:if="{{loading}}" class="hl-loading">加载中…</view>

  <block wx:if="{{task && !loading}}">
    <!-- 原型 teacher-task-detail.html 第一块 `.chunk`：抬头（发起方药丸＋标题＋摘要）
         与「任务说明」同在一张卡里。
         抬头上**没有状态药丸，也没有截止时间** —— 状态在下面「任务操作」那一节的标题
         行里，截止时间原型一处也没画（园方 2026-08-27 裁定：原型没画的一律不画）。 -->
    <view class="hl-card">
      <view class="detail__head">
        <view wx:if="{{task.creator_label}}" class="detail__kicker">{{task.creator_label}}</view>
        <view class="detail__title">{{task.task_title}}</view>
        <view class="detail__intro">{{task.task_intro}}</view>
      </view>

      <view class="detail__chunk-title">任务说明</view>
      <!-- 原型这一块有三个 `.block`：背景信息、分工要求、时间节点。`db_task` 只有
           `task_division` 一列对得上（`task_intro` 已经是上面那句摘要），另两块没有
           任何列可读，就不摆空盒子。缺口记在票据 27。 -->
      <view class="detail__label">分工要求</view>
      <view class="detail__text">{{task.task_division}}</view>
    </view>

    <!-- 原型第二块 `.chunk`「任务附件」：逐行分隔的 `.attach-row`，左边文件名与体积，
         右边「预览」「下载」两枚。两枚都点得下去，点了说明为什么还打不开 ——
         `db_file_ref owner_object='db_task_assign'` 的取链端点在契约里还不存在（G40）。 -->
    <view class="hl-card">
      <view class="detail__chunk-title">任务附件</view>
      <view wx:if="{{task.files.length === 0}}" class="detail__none">暂无附件</view>
      <view wx:for="{{task.files}}" wx:key="file_id" class="detail__attach">
        <view class="detail__file-text">
          <view class="detail__file-name">{{item.file_name}}</view>
          <view class="detail__file-meta">{{item.size_label}}</view>
        </view>
        <view class="detail__file-acts">
          <view class="detail__file-btn" bindtap="onFileTap">预览</view>
          <view class="detail__file-btn" bindtap="onFileTap">下载</view>
        </view>
      </view>
    </view>

    <!-- 原型第三块 `.chunk`「任务操作」：标题右侧一枚状态药丸，下面两枚按钮。
         整块在任务已完成时**收起来**，与原型的 `operationSection.hidden` 一致。

         「接受」是真写入（a1 → a2，无请求体，不携带内容，因此不过内容安全闸门）。
         「完成」点得下去但办不成：它与「提交材料」共用 `POST /tasks/{id}/completion`，
         两者怎么分工在任何一份权威里都没定（G40），点了就说这一句。 -->
    <view wx:if="{{task.assign_status !== 'a3'}}" class="hl-card">
      <view class="detail__chunk-title">
        任务操作
        <text class="hl-pill {{task.assign_status_class}}">{{task.assign_status_label}}</text>
      </view>
      <view class="detail__ops">
        <view
          class="detail__op {{task.assign_status !== 'a1' ? 'detail__op--on' : ''}}"
          bindtap="onAcceptTap">{{accepting ? '处理中…' : '接受'}}</view>
        <view class="detail__op" bindtap="onCompleteTap">完成</view>
      </view>
      <view wx:if="{{opNotice}}" class="detail__op-notice">{{opNotice}}</view>
    </view>

    <!-- 原型第四块：`.submit-card`，青色虚线框的说明卡，卡里才是按钮。
         任务已完成时同样收起来（原型 `submitSection.hidden`）。
         这里是入口，不是控件：本页不提交、不编辑、不删除。 -->
    <view wx:if="{{task.assign_status !== 'a3'}}" class="submit-card">
      <view class="submit-card__title">提交材料 / 反馈</view>
      <view class="submit-card__desc">教师只需按分工上传照片、记录、说明或反馈。提交后进入管理端审核与汇总。</view>
      <view
        class="submit {{submitDisabled ? 'submit--off' : ''}}"
        bindtap="onSubmitTap">
        提交材料
      </view>
      <view wx:if="{{submitReason}}" class="submit__reason">{{submitReason}}</view>
    </view>
  </block>
</view>
