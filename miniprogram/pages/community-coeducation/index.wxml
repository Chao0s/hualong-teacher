<!-- 社区共育 —— 对照原型 screens/community-coeducation.html。

     一张卡片是**一笔家长投稿**，不是一条任务：一条任务对 N 笔投稿。
     两个筛选都是查询参数、不是列；「全部」表示不加这条筛选条件，不是某个列值。
     时间窗的边界由服务端算，这一页一个日期都不推。

     「加入成长册」写 db_parent_task_submission 的教师分支，与家长那一支各自独立。 -->
<view class="page">

  <view class="filter-panel">
    <view>
      <text class="filter-field__label">时间</text>
      <picker mode="selector" range="{{timeOptions}}" range-key="label" value="{{timeIndex}}" bindchange="onTimeChange">
        <view class="filter-field__select">{{timeOptions[timeIndex].label}}</view>
      </picker>
    </view>
    <view>
      <text class="filter-field__label">任务类别</text>
      <picker mode="selector" range="{{typeOptions}}" range-key="label" value="{{typeIndex}}" bindchange="onTypeChange">
        <view class="filter-field__select">{{typeOptions[typeIndex].label}}</view>
      </picker>
    </view>
  </view>

  <view class="empty" wx:if="{{loading}}">加载中…</view>
  <view class="empty" wx:elif="{{failed}}">{{failed}}</view>

  <view class="feed-list" wx:elif="{{visible.length}}">
    <view class="moment-card" wx:for="{{visible}}" wx:key="id" wx:for-item="post" wx:for-index="pi">
      <view class="avatar {{post.tone ? 'avatar--' + post.tone : ''}}">{{post.initial}}</view>
      <view class="post-body">
        <view class="moment-head">
          <text class="moment-head__title">{{post.author}}</text>
          <text class="moment-head__time">{{post.time}}</text>
        </view>

        <!-- 还在内容检查里的那一笔不带出正文与照片：没过闸门的内容不显示。 -->
        <text class="post-text" wx:if="{{post.underCheck}}">这一笔正在内容检查中，通过后显示。</text>
        <text class="post-text" wx:else>{{post.text}}</text>

        <!-- 格子数来自真实的 file_id，地址随后逐张填上（§8.4 每次重验），
             url 为空时先显示灰底，不让布局在图片陆续到达时跳动。 -->
        <view class="photo-grid {{post.photos.length <= 2 ? 'photo-grid--two' : ''}}" wx:if="{{post.photos.length}}">
          <view class="feed-photo" wx:for="{{post.photos}}" wx:key="fileId" wx:for-item="p"
            data-id="{{post.id}}" data-file-id="{{p.fileId}}" bindtap="onPreviewPhotos" hover-class="feed-photo--hover">
            <image class="feed-photo__img" wx:if="{{p.url}}" src="{{p.url}}" mode="aspectFill" lazy-load />
          </view>
          <view class="feed-more" wx:if="{{post.moreCount}}" data-id="{{post.id}}" data-file-id="{{post.fileIds[3]}}" bindtap="onPreviewPhotos" hover-class="feed-photo--hover">+{{post.moreCount}}</view>
        </view>

        <view class="moment-foot">
          <text class="pill">{{post.typeLabel}}</text>
          <text class="moment-foot__task">{{post.taskTitle}}</text>
          <view
            class="add-material {{post.included ? 'add-material--on' : ''}}"
            data-id="{{post.id}}"
            bindtap="onToggleMaterial"
          >{{post.included ? '− 移出成长册' : '+ 加入成长册'}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="empty" wx:else>当前筛选下暂无家长提交内容</view>

</view>
