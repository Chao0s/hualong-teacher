/* 案例详情 —— 逐条对照原型 screens/case-detail.html。1px 记 2rpx。
 * 和资源详情一样，这一页原型自带米底 #f5f4f1、蓝主色 #2f6feb 的配色。 */

page {
  background: #f5f4f1;
}

.page {
  padding: 24rpx 32rpx 40rpx;
}

/* ── 案例卡 ────────────────────────────────────────────────────────────── */

.detail-card {
  padding: 36rpx;
  margin-bottom: 20rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.04);
}

.detail-title {
  display: block;
  margin-bottom: 24rpx;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.35;
}

.tag-row {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin: -4rpx 0 32rpx;
}

.tag {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #e8f0fe;
  color: #2f6feb;
  font-size: 22rpx;
}

.sec-title {
  margin-bottom: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.sec-title--gap {
  margin-top: 36rpx;
}

.body-text {
  display: block;
  font-size: 28rpx;
  line-height: 1.65;
}

.link-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 32rpx;
  padding: 28rpx 32rpx;
  border: 1rpx solid #e8e5df;
  border-radius: 24rpx;
  background: #f8f7f4;
}

.link-card--hover {
  background: #f2f0ec;
}

.link-card__body {
  flex: 1;
  min-width: 0;
}

.link-card__name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
}

.link-card__meta {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #8c8a84;
}

.link-card__arrow {
  flex: 0 0 auto;
  margin-left: 16rpx;
  color: #2f6feb;
  font-size: 32rpx;
}

/* ── 下载按钮 ──────────────────────────────────────────────────────────── */

.detail-actions {
  margin-top: 36rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid #e8e5df;
}

.btn-dl {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  border: 1rpx solid #e8e5df;
  border-radius: 24rpx;
  background: #f8f7f4;
}

.btn-dl--hover {
  background: #f2f0ec;
}

.btn-dl__body {
  flex: 1;
  min-width: 0;
}

.btn-dl__title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
}

.btn-dl__note {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  font-weight: 400;
  color: #8c8a84;
}

.btn-dl__arrow {
  flex: 0 0 auto;
  margin-left: 16rpx;
  color: #2f6feb;
  font-weight: 600;
}
