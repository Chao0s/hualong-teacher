<!-- 案例详情 —— 对照原型 screens/case-detail.html。
     这一页和资源详情共用另一套配色（米底 #f5f4f1、蓝主色 #2f6feb）。

     原型下半屏那份「Word版完整详案」已经删掉：db_case 没有任何一列存它，
     它是 word_file_id 指向的 .docx 的正文。理由见 index.js 头注。 -->
<view class="page">

  <view class="detail-card" wx:if="{{loading}}">
    <text class="body-text">正在加载…</text>
  </view>

  <view class="detail-card" wx:elif="{{error}}">
    <text class="body-text">{{error}}</text>
    <text class="link-card__arrow" bindtap="onRetry">重试</text>
  </view>

  <view class="detail-card" wx:else>
    <text class="detail-title">{{title}}</text>
    <view class="tag-row">
      <text class="tag" wx:for="{{tags}}" wx:key="*this">{{item}}</text>
    </view>

    <block wx:for="{{sections}}" wx:key="title">
      <view class="sec-title {{index === 0 ? '' : 'sec-title--gap'}}">{{item.title}}</view>
      <text class="body-text">{{item.text}}</text>
    </block>

    <!-- 关联资源是 db_case.resource_ids 的正向展开，可能不止一条，也可能没有。 -->
    <view
      class="link-card"
      hover-class="link-card--hover"
      hover-stay-time="80"
      wx:for="{{relatedResources}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onResourceTap"
    >
      <view class="link-card__body">
        <text class="link-card__name">关联资源：{{item.name}}</text>
        <text class="link-card__meta">{{item.meta}}</text>
      </view>
      <text class="link-card__arrow">→</text>
    </view>

    <view class="detail-actions" wx:if="{{hasPlan}}">
      <view class="btn-dl" hover-class="btn-dl--hover" hover-stay-time="80" bindtap="onDownloadPlan">
        <view class="btn-dl__body">
          <text class="btn-dl__title">下载Word详案</text>
          <text class="btn-dl__note">查看完整活动目标、流程、延伸与评价反思</text>
        </view>
        <text class="btn-dl__arrow">↓</text>
      </view>
    </view>
  </view>

</view>
