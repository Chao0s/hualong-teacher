/* 任务详情（待办任务）—— 逐条对照原型 screens/teacher-task-detail.html。1px 记 2rpx。 */

.page {
  padding: 24rpx 32rpx 56rpx;
}

.hint {
  padding: 32rpx;
  color: var(--muted);
  text-align: center;
  font-size: 26rpx;
}

.chunk {
  padding: 30rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid var(--border);
  border-radius: 32rpx;
  background: var(--surface);
}

/* ── 任务抬头 ──────────────────────────────────────────────────────────── */

.task-head {
  padding-bottom: 28rpx;
  margin-bottom: 28rpx;
  border-bottom: 1rpx solid var(--border);
}

.kicker {
  display: inline-flex;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: var(--accent-light);
  color: var(--accent-dark);
  font-size: 22rpx;
  font-weight: 800;
}

.task-head__title {
  display: block;
  margin-top: 24rpx;
  font-size: 42rpx;
  line-height: 1.25;
  font-weight: 700;
}

.task-head__sub {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--muted);
}

.chunk-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.chunk-title__text {
  font-size: 32rpx;
  font-weight: 700;
}

/* 徽章显示的是自己那一行的 assign_status（F28），三档与待办任务卡片同色。 */
.status {
  flex: 0 0 auto;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
  white-space: nowrap;
}

.status--wait { color: #a15d00; background: var(--amber-light); }
.status--doing { color: #226ac7; background: var(--blue-light); }
.status--done { color: var(--green); background: var(--green-light); }

/* ── 说明与分工 ────────────────────────────────────────────────────────── */

.block {
  padding-top: 24rpx;
  border-top: 1rpx solid var(--border);
}

/* 原型用 `.block:first-child` 去掉第一段的上边线；这里第一段在 wxml 里直接带类。 */
.block--first {
  padding-top: 0;
  border-top: 0;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--muted);
}

.text {
  display: block;
  font-size: 28rpx;
  line-height: 1.65;
}

/* ── 附件 ──────────────────────────────────────────────────────────────── */

/* 原型的 `.attach{display:grid;gap:1px}`：行之间靠 1px 缝，分隔线是下一行的上边框。 */
.attach {
  display: grid;
  gap: 2rpx;
}

.attach-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: 20rpx;
  min-height: 92rpx;
  padding: 18rpx 0;
}

.attach-row + .attach-row {
  border-top: 1rpx solid var(--border);
}

.file-name {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
}

.file-op {
  color: var(--accent-dark);
  font-size: 24rpx;
  font-weight: 800;
}

/* ── 任务操作 ──────────────────────────────────────────────────────────── */

.feedback {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  background: #fff;
  font-size: 26rpx;
  line-height: 1.6;
}

.feedback__ph {
  color: var(--muted);
}

.primary {
  margin-top: 24rpx;
  padding: 24rpx 28rpx;
  border-radius: 26rpx;
  background: var(--accent);
  color: #fff;
  text-align: center;
  font-size: 28rpx;
  font-weight: 800;
}

.primary--hover {
  opacity: 0.85;
}

.note {
  display: block;
  margin-top: 24rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: var(--muted);
}
