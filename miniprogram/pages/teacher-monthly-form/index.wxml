<!-- 填写月度评价 —— 对照原型 screens/teacher-monthly-form.html。

     月份由本学期完整覆盖的那几个月生成，幼儿由本班在园名册生成，都不写死。
     相册是这个孩子的在园时光照片（E7），换幼儿或换月份会清掉已勾选的照片。
     已发布的只读：契约里没有 e3 回 e1 这条边。 -->
<view class="page">

  <view class="empty-hint" wx:if="{{loading}}">加载中…</view>
  <view class="empty-hint" wx:elif="{{error}}">{{error}}</view>

  <view class="chunk" wx:else>
    <view class="state-line" wx:if="{{status}}">
      <text class="pill">{{statusLabel}}</text>
      <text class="state-line__note" wx:if="{{readonly}}">已发布，不能再改</text>
    </view>

    <text class="form-label form-label--first">评价月份</text>
    <picker mode="selector" range="{{months}}" range-key="label" value="{{monthIndex}}" bindchange="onMonthChange">
      <view class="select">{{months[monthIndex].label}}</view>
    </picker>

    <text class="form-label">评价幼儿</text>
    <picker mode="selector" range="{{children}}" value="{{childIndex}}" bindchange="onChildChange">
      <view class="select">{{children[childIndex]}}</view>
    </picker>

    <text class="form-label">评价内容</text>
    <textarea
      class="textarea"
      maxlength="500"
      disabled="{{readonly}}"
      value="{{content}}"
      bindinput="onContentInput"
    />

    <text class="form-label">关联在园时光照片</text>
    <scroll-view class="photo-row" scroll-x enable-flex wx:if="{{imported.length}}">
      <view class="photo imported" wx:for="{{imported}}" wx:key="fileId">
        <image class="photo__img" wx:if="{{item.url}}" src="{{item.url}}" mode="aspectFill" lazy-load />
        <text wx:else>{{item.label}}</text>
        <text class="photo-demo" wx:if="{{item.demo}}">示例图片</text>
        <view class="remove" wx:if="{{!readonly}}" catchtap="onRemoveImported" data-fileid="{{item.fileId}}">×</view>
      </view>
    </scroll-view>
    <view class="empty-hint" wx:else>{{readonly ? '这份评价未关联照片。' : '尚未导入照片，点击下方按钮从该幼儿的相册中选择。'}}</view>

    <block wx:if="{{!readonly}}">
      <view class="btn btn--blue full" hover-class="btn--hover" bindtap="onOpenAlbum">选择照片</view>
      <view class="btn btn--ghost full full--gap" hover-class="btn--hover" bindtap="onSave">保存草稿</view>
      <view class="btn btn--primary full full--gap" hover-class="btn--hover" bindtap="onPublish">发布给家长</view>
    </block>
  </view>

</view>

<!-- 在园时光相册 -->
<view class="sheet-mask" wx:if="{{albumOpen}}" bindtap="onCloseAlbum"></view>
<view class="sheet" wx:if="{{albumOpen}}">
  <view class="sheet-head">
    <text class="sheet-head__title">{{albumTitle}}</text>
    <view class="close" bindtap="onCloseAlbum">×</view>
  </view>

  <view class="empty-hint" wx:if="{{albumLoading}}">加载中…</view>
  <view class="empty-hint" wx:elif="{{!visibleGroups.length}}">这个孩子还没有被在园时光标注过，相册是空的。</view>

  <scroll-view class="album-scroll" scroll-y wx:else>
    <!-- 选中与否读的是每一行自己的 `sel`，**不在模板里算 indexOf**：
         这是嵌套 wx:for（外层 group、内层默认 item），模板作用域里那个表达式
         取不到值，边框与勾选标记会一起失效。见 index.js 的 onTogglePhoto 头注。

         定位用两级下标 gi/pi，不用 fileId —— 那是我自己发的整数，不经 dataset 转换。 -->
    <view
      class="album-group"
      wx:for="{{visibleGroups}}"
      wx:key="title"
      wx:for-item="group"
      wx:for-index="gi"
    >
      <text class="group-title">{{group.title}}</text>
      <view class="album-grid">
        <view
          class="album-photo {{item.sel ? 'album-photo--sel' : ''}}"
          wx:for="{{group.photos}}"
          wx:key="fileId"
          wx:for-index="pi"
          data-gi="{{gi}}"
          data-pi="{{pi}}"
          bindtap="onTogglePhoto"
        >
          <image class="album-photo__img" wx:if="{{item.url}}" src="{{item.url}}" mode="aspectFill" lazy-load />
          <text class="album-photo__label" wx:else>{{item.label}}</text>
          <text class="photo-demo" wx:if="{{item.demo}}">示例图片</text>
          <view class="album-photo__tick {{item.sel ? '' : 'album-photo__tick--off'}}">✓</view>
        </view>
      </view>
    </view>
  </scroll-view>

  <view class="sheet-actions">
    <view class="btn btn--ghost" hover-class="btn--hover" bindtap="onCloseAlbum">取消</view>
    <view class="btn btn--primary" hover-class="btn--hover" bindtap="onConfirmAlbum">{{confirmText}}</view>
  </view>
</view>
