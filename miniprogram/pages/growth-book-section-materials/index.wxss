@import '/styles/home-school-common.wxss';

/* 栏目投稿管理 —— 本页自己的样式，对照原型 screens/growth-book-section-materials.html 的内联块。1px 记 2rpx。
 * 共用样式里的 .avatar 是 24rpx 圆角方块，这里是圆形，本页覆盖掉。 */

.page {
  padding: 24rpx 32rpx 56rpx;
}

.summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--border);
  border-radius: 26rpx;
  background: #fff;
}

.summary__label {
  color: var(--muted);
  font-size: 24rpx;
}

.summary__value {
  font-size: 36rpx;
  font-weight: 700;
}

/* ── 三个筛选 ──────────────────────────────────────────────────────────── */

.tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.tabs__btn {
  padding: 14rpx 24rpx;
  border: 1rpx solid var(--border);
  border-radius: 999rpx;
  background: #fff;
  font-size: 22rpx;
}

.tabs__btn--on {
  border-color: var(--accent);
  background: var(--accent);
  color: #fff;
}

/* ── 投稿卡 ────────────────────────────────────────────────────────────── */

.submission {
  margin-bottom: 16rpx;
  border: 1rpx solid var(--border);
  border-radius: 24rpx;
  background: #fff;
  overflow: hidden;
}

.row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
}

.avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  font-size: 24rpx;
  font-weight: 400;
}

.grow {
  flex: 1;
  min-width: 0;
}

.grow__name {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
}

.meta {
  display: block;
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 20rpx;
}

.row__btn {
  flex: 0 0 auto;
  padding: 12rpx 20rpx;
  border: 1rpx solid var(--border);
  border-radius: 999rpx;
  background: #fff;
  font-size: 20rpx;
}

.row__btn--primary {
  border-color: var(--accent);
  background: var(--accent);
  color: #fff;
}

.detail {
  padding: 24rpx;
  border-top: 1rpx solid var(--border);
}

.photos {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.photo {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 184rpx;
  padding: 16rpx;
  border-radius: 20rpx;
  background: linear-gradient(145deg, #dff4ef, #f8d8bc);
  color: #52706d;
  font-size: 22rpx;
  text-align: center;
}

.parent-text {
  display: block;
  margin: 20rpx 4rpx 0;
  font-size: 24rpx;
  line-height: 1.7;
}

.empty {
  padding: 48rpx;
  border: 1rpx dashed var(--border);
  border-radius: 24rpx;
  background: #fff;
  color: var(--muted);
  font-size: 24rpx;
  text-align: center;
}

/* ── 删除栏目 ──────────────────────────────────────────────────────────── */

.section-actions {
  display: grid;
  gap: 20rpx;
  margin-top: 36rpx;
}

.btn--danger {
  width: 100%;
  border-color: #f0c8c8;
  background: #fff;
  color: var(--danger);
}
