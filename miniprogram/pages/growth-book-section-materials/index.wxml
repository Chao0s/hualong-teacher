<!-- 栏目投稿管理 —— 对照原型 screens/growth-book-section-materials.html。
     页面标题是栏目名，由 js 写进导航栏。
     原型的「查看」与展开后的照片、正文没有复刻：教师端读不到任何一笔家庭投稿的内容
     （契约里回 BookMaterialSubmission 的只有家长端那一条），没有数据源就不渲染。 -->
<view class="page">

  <view class="empty" wx:if="{{loadError}}">{{loadError}}</view>

  <block wx:else>
    <view class="summary">
      <text class="summary__label">已收齐</text>
      <text class="summary__value">{{doneCount}} / {{totalCount}}</text>
    </view>

    <text class="hint judge-note" wx:if="{{judgeNote}}">{{judgeNote}}</text>

    <view class="tabs">
      <view
        class="tabs__btn {{filter === tab.key ? 'tabs__btn--on' : ''}}"
        wx:for="{{tabs}}"
        wx:key="key"
        wx:for-item="tab"
        data-key="{{tab.key}}"
        bindtap="onFilter"
      >{{tab.label}}</view>
    </view>

    <view class="submission" wx:for="{{visible}}" wx:key="id" wx:for-item="row">
      <view class="row">
        <view class="avatar">{{row.initial}}</view>
        <view class="grow">
          <text class="grow__name">{{row.name}}</text>
          <text class="meta">{{row.judged ? (row.done ? '已交齐' : '未交齐') : '无齐备判定'}}</text>
        </view>
        <view
          class="row__btn row__btn--primary"
          wx:if="{{!row.done}}"
          hover-class="btn--hover"
          data-id="{{row.id}}"
          bindtap="onRemind"
        >提醒家长</view>
      </view>
    </view>
    <view class="empty" wx:if="{{!visible.length}}">暂无记录</view>

    <view class="section-actions">
      <view
        class="btn btn--danger"
        style="{{deleteDisabled ? 'opacity:.45' : ''}}"
        hover-class="btn--hover"
        bindtap="onDeleteSection"
      >删除栏目</view>
    </view>
    <text class="hint delete-note">{{deleteNote}}</text>
  </block>

</view>
