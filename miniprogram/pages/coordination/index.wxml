<view class="hl-page" wx:if="{{ready}}">
  <!-- 原型 comprehensive-coordination.html 顶部的说明卡。 -->
  <view class="banner">
    <text class="banner__kicker">园务协同支持</text>
    <view class="banner__title">统筹行政、人事与后勤保障</view>
    <view class="banner__desc">集中查看园内制度、通知、安全卫生与教师发展支持事项。</view>
    <view class="banner__mark">协</view>
  </view>

  <!-- 三节七卡，一类一卡（原型的三个 `.section-grid`）。行政统筹三列，其余两列。 -->
  <block wx:for="{{sections}}" wx:key="title">
    <view class="sec">{{item.title}}</view>
    <view class="grid {{item.wide ? 'grid--wide' : ''}}">
      <view
        wx:for="{{item.entries}}"
        wx:for-item="entry"
        wx:key="key"
        class="card"
        data-key="{{entry.key}}"
        bindtap="onEntryTap">
        <view class="card__mark card__mark--{{entry.tint}}">{{entry.mark}}</view>
        <view class="card__title">{{entry.label}}</view>
        <view class="card__desc">{{entry.desc}}</view>
      </view>
    </view>
  </block>
</view>
