/* 说明卡 —— 原型 comprehensive-coordination.html 的 `.banner`。 */
.banner {
  position: relative;
  overflow: hidden;
  min-height: 276rpx;
  padding: var(--space-4);
  margin-bottom: var(--space-4);
  border-radius: var(--radius);
  background: var(--surface);
  box-shadow: var(--shadow-soft);
}

/* 原型右下角那枚浅色圆。它只是底纹，压在文字下面。 */
.banner::after {
  content: '';
  position: absolute;
  right: -40rpx;
  bottom: -60rpx;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: var(--accent-light);
}

.banner__kicker {
  position: relative;
  z-index: 1;
  display: inline-flex;
  align-items: center;
  height: 48rpx;
  padding: 0 var(--space-2);
  border-radius: var(--radius-pill);
  background: var(--accent-light);
  color: var(--accent-dark);
  font-size: 22rpx;
  font-weight: 600;
}

.banner__title {
  position: relative;
  z-index: 1;
  margin-top: var(--space-3);
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1.4;
  color: var(--fg);
}

.banner__desc {
  position: relative;
  z-index: 1;
  width: 470rpx;
  margin-top: var(--space-1);
  font-size: 24rpx;
  color: var(--muted);
}

.banner__mark {
  position: absolute;
  right: var(--space-4);
  bottom: var(--space-4);
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  border-radius: var(--radius);
  background: var(--accent);
  color: #fff;
  font-size: 44rpx;
  font-weight: 600;
}

/* 分节标题 —— 原型的 `.sec`：16px 粗体，上 20px 下 10px。 */
.sec {
  margin: 40rpx 0 20rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--fg);
}

/* 类目卡网格 —— 原型 `.section-grid`：行政统筹三列，其余两列。 */
.grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.grid--wide {
  grid-template-columns: repeat(2, 1fr);
}

/* `.entry-card`：描边卡，字标在上、标题与描述在下，三列时略高一点。 */
.card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  min-height: 212rpx;
  padding: 24rpx 20rpx;
  border: 1px solid var(--border);
  border-radius: 32rpx;
  background: var(--surface);
}

.grid--wide .card {
  min-height: 192rpx;
  padding: 26rpx 24rpx;
}

.card__mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  font-weight: 800;
}

.card__mark--accent { color: var(--accent-dark); background: var(--accent-light); }
.card__mark--blue   { color: var(--blue);        background: var(--blue-light); }
.card__mark--amber  { color: var(--amber);       background: var(--amber-light); }
.card__mark--danger { color: var(--danger);      background: var(--danger-light); }
.card__mark--green  { color: var(--green);       background: var(--green-light); }
.card__mark--orange { color: var(--orange);      background: var(--orange-light); }

/* 标题与描述贴着卡片底部，字标留在顶上（原型的 `justify-content: space-between`）。 */
.card__title {
  margin-top: auto;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.2;
}

.card__desc {
  font-size: 22rpx;
  line-height: 1.35;
  color: var(--muted);
}
