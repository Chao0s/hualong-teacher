<!-- 党建学习 · 全部文件 —— 对照原型 screens/party-study-list.html。 -->
<view class="page">

  <view class="summary">
    <text class="summary__title">全部学习文件</text>
    <text class="summary__desc">集中查看政策文件、专题学习材料与园内制度学习内容。</text>
  </view>

  <view class="summary" wx:if="{{loading || error}}">
    <text class="summary__title">{{loading ? '正在加载…' : '加载失败'}}</text>
    <text class="summary__desc" wx:if="{{error}}" bindtap="onRetry">{{error}}　点此重试</text>
  </view>

  <view class="list">
    <view
      class="item"
      hover-class="item--hover"
      hover-stay-time="80"
      wx:for="{{docs}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onItemTap"
    >
      <view class="mark">学</view>
      <view class="item__main">
        <text class="item__title">{{item.title}}</text>
        <view class="item__meta">
          <text wx:for="{{item.meta}}" wx:key="*this" wx:for-item="m">{{m}}</text>
        </view>
      </view>
      <text class="pill">预览</text>
    </view>
  </view>

</view>
