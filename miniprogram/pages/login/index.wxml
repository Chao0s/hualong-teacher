<!-- 登录 —— 契约 §6.2 的两段式。实作在 utils/auth.js（本页只调它），依据见 index.js 头注。

     第一段静默走：进页就 wx.login 拿 js_code 发 POST /auth/session { surface, js_code }。
     服务端认得这台微信与名册的绑定就直接签票（本页跳首页）；认不出就回 409
     identity_binding_required —— 只有那时才亮出下面那颗「验证手机号」按钮。

     这个工程里今天只有一条路会走到 409：生产环境（config.env.devSession=false）。
     测试后端不连微信，signIn() 直接走 POST /dev/session 就回首页，所以在开发工具里
     这一段永远看不到。手机号那一步今天没接，见 index.js 的 onGetPhoneNumber()。 -->
<view class="page">

  <view class="intro" wx:if="{{loading}}">
    <view class="intro__glyph">化</view>
    <text class="intro__title">正在登录…</text>
    <text class="intro__body">正在用微信身份核对你在园所名册上的记录。这一步不需要输入，也不用点任何东西。</text>
  </view>

  <!-- 409 identity_binding_required 才出现。`getRealtimePhoneNumber` 是现行的手机号
       快验接口；旧的 getPhoneNumber 已废弃，不用（auth.js 头注引 A2）。 -->
  <view class="intro" wx:elif="{{needsPhone}}">
    <view class="intro__glyph intro__glyph--phone">号</view>
    <text class="intro__title">这台微信还没绑定手机号</text>
    <text class="intro__body">园所按手机号认人，所以第一次要验证一次。验证过之后，这台微信以后就直接登录 —— 手机号不是每次登录都验。</text>
    <button class="phone-btn" hover-class="phone-btn--hover" open-type="getRealtimePhoneNumber" bindgetphonenumber="onGetPhoneNumber">验证手机号</button>
    <text class="intro__note">{{phoneNote}}</text>
  </view>

  <!-- 失败。主文案取自 utils/errors.js 的登记表（err.userMessage），页面不自己译错误码；
       只有 F17 那条安全阻断要多说一句，见 index.js 的 QUOTA_STOP_NOTE。 -->
  <view class="intro" wx:else>
    <view class="intro__glyph intro__glyph--fail">!</view>
    <text class="intro__title">登录没有完成</text>
    <text class="intro__body">{{failed}}</text>
    <text class="intro__note" wx:if="{{quotaStop}}">{{quotaStopNote}}</text>
    <view class="btn btn--primary" hover-class="btn--hover" bindtap="onRetry">重试</view>
  </view>

</view>
