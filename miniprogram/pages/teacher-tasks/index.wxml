<!-- 待办任务 —— 对照原型 screens/teacher-tasks.html。
     原型的分组（当前／历史）、卡片摘要与脚上三枚标签都删掉了，
     理由逐条写在 index.js 的头注里。徽章取自己那一行的 assign_status（F28）。 -->
<view class="page">

  <view class="sec">待办任务</view>

  <view class="hint" wx:if="{{loading}}">正在加载…</view>
  <view class="hint" wx:elif="{{error}}" bindtap="onRetry">{{error}}　点此重试</view>

  <block wx:elif="{{tasks.length}}">
    <view
      class="card"
      hover-class="card--hover"
      hover-stay-time="80"
      wx:for="{{tasks}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onCardTap"
    >
      <view class="top">
        <text class="title">{{item.title}}</text>
        <text class="badge badge--{{item.tone}}">{{item.statusLabel}}</text>
      </view>
      <text class="meta">截止 {{item.dueLabel}}</text>
    </view>
  </block>

  <view class="hint" wx:else>你名下没有待办任务。</view>

</view>
