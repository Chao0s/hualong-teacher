@import '/styles/home-school-common.wxss';

/* 亲子任务 —— 本页自己的样式，对照原型 screens/parent-tasks.html 的内联块。 */

.page {
  padding: 24rpx 32rpx 56rpx;
}

.publish-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 176rpx;
  padding: 32rpx;
  border-radius: 32rpx;
  background: var(--surface);
}

.publish-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 88rpx;
  height: 88rpx;
  border-radius: 30rpx;
  background: var(--accent-light);
  color: var(--accent-dark);
  font-size: 44rpx;
  font-weight: 600;
}

.publish-main {
  flex: 1;
  min-width: 0;
}

.publish-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
}

.publish-meta {
  display: block;
  margin-top: 10rpx;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.4;
}

.type-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 80rpx;
  min-height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  color: var(--accent-dark);
  background: var(--accent-light);
  font-size: 22rpx;
  font-weight: 600;
}

.type-pill--community {
  color: var(--green);
  background: var(--green-light);
}

/* 状态标签。只在非「已发布」的卡片上出现：草稿要能一眼认出来，已结束的也要。
   与 type-pill 同一个形状、不同底色，因为它们是两个维度而不是两个值。 */
.status-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  color: var(--muted);
  background: var(--bg);
  font-size: 22rpx;
  font-weight: 600;
}
