<!-- 亲子任务 —— 数据来自 GET /home-school/parent-tasks。草稿也在这一页，见 index.js 头注。 -->
<view class="page">

  <view class="sec sec--first">发布新任务</view>
  <view class="publish-card" hover-class="list-card--hover" hover-stay-time="80" bindtap="onPublish">
    <view class="publish-icon">＋</view>
    <view class="publish-main">
      <text class="publish-title">发布新任务</text>
      <text class="publish-meta">进入后选择日常任务或社区任务，填写任务背景与详情，并选定开始时间。</text>
    </view>
    <text class="chev">›</text>
  </view>

  <view class="sec">历史任务</view>

  <view class="hint" wx:if="{{loading}}">正在加载任务…</view>
  <view class="hint" wx:elif="{{error}}" bindtap="onRetry">{{error}}　点此重试</view>
  <view class="hint" wx:elif="{{tasks.length === 0}}">本班还没有亲子任务。</view>

  <view
    class="list-card"
    hover-class="list-card--hover"
    hover-stay-time="80"
    wx:for="{{tasks}}"
    wx:key="id"
    data-url="{{item.url}}"
    bindtap="onTaskTap"
  >
    <view class="mark {{item.tone ? 'mark--' + item.tone : ''}}">{{item.glyph}}</view>
    <view class="list-main">
      <text class="list-title">{{item.title}}</text>
      <view class="list-meta">
        <text class="type-pill {{item.community ? 'type-pill--community' : ''}}">{{item.typeLabel}}</text>
        <text class="status-pill" wx:if="{{!item.published}}">{{item.statusLabel}}</text>
        <text> {{item.meta}}</text>
      </view>
    </view>
    <text class="chev">›</text>
  </view>

  <view class="hint" wx:if="{{loadingMore}}">正在加载更多…</view>

</view>
