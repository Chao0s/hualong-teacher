<!-- 发布家长测评 —— 对照原型 screens/parent-evaluation-publish.html。

     教师在这里写的是给家长看的「评价说明」（db_parent_evaluation.evaluation_prompt），
     不是家长回填的 evaluation_text —— 那两个控件在家长端的月度／学期评价页。

     原型只有「评价类型」与「评价说明」两格，而 DDL 上 evaluation_period、
     evaluation_title、start_at 都是 NOT NULL —— 那张表单在原型里根本提交不成功。
     月度期间可选择月份，学期期间取当前学期；标题与时间可填写。 -->
<view class="page">

  <view class="chunk">
    <text class="form-label form-label--first">评价类型</text>
    <picker mode="selector" range="{{types}}" value="{{typeIndex}}" bindchange="onTypeChange">
      <view class="select">{{types[typeIndex]}}</view>
    </picker>

    <text class="form-label">评价期间</text>
    <picker wx:if="{{typeIndex === 0}}" mode="date" fields="month" value="{{month}}" bindchange="onMonthChange" disabled="{{publishing}}" data-ui="context.local">
      <view class="select">{{periodLabel || '请选择评价月份'}}　›</view>
    </picker>
    <view wx:else class="select select--readonly">{{periodLabel || '算不出期间，请检查当前学期'}}</view>
    <text class="hint">月度评价默认本月，可点击选择其他月份；学期评价使用当前学期。一名幼儿一个期间只有一份。</text>

    <text class="form-label">评价标题</text>
    <view class="input title-field">
      <textarea class="title-input" auto-height maxlength="100" value="{{title}}" bindinput="onTitleInput" />
    </view>

    <!-- 只挑日期。库里仍存一个钟点（TIMESTAMP NOT NULL），但那个钟点对家长
         没有区别，固定成开始 08:00、截止 21:00，见 index.js 的 START_CLOCK。 -->
    <text class="form-label">开始日期</text>
    <picker mode="date" value="{{startDate}}" bindchange="onStartDate">
      <view class="select">{{startDate}}</view>
    </picker>

    <text class="form-label">截止日期</text>
    <picker mode="date" value="{{dueDate}}" bindchange="onDueDate">
      <view class="select">{{dueDate}}</view>
    </picker>

    <text class="form-label">评价说明</text>
    <textarea class="textarea" maxlength="1000" value="{{prompt}}" bindinput="onPromptInput" />

    <view class="btn btn--primary full full--gap" hover-class="btn--hover" bindtap="onPublish">
      {{publishing ? '正在发布…' : '发布给家长'}}
    </view>
    <text class="hint hint--gap">一次给本班每名在园幼儿各开一份。已经开过的那些不会被覆盖。</text>
  </view>

  <view class="sec">过往进度</view>

  <view class="empty" wx:if="{{loading}}">加载中…</view>
  <view class="empty" wx:elif="{{failed}}">{{failed}}</view>

  <block wx:elif="{{history.length}}">
    <view
      class="list-card"
      hover-class="list-card--hover"
      hover-stay-time="80"
      wx:for="{{history}}"
      wx:key="key"
      wx:for-index="hi"
      data-index="{{hi}}"
      bindtap="onHistoryTap"
    >
      <view class="mark">{{item.mark}}</view>
      <view class="list-main">
        <text class="list-title">{{item.title}}</text>
        <text class="list-meta">{{item.meta}}</text>
      </view>
      <text class="chev">›</text>
    </view>
  </block>

  <view class="empty" wx:else>本班还没有发布过家长评价</view>

</view>
