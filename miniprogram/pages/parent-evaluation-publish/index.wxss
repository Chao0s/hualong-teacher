@import '/styles/home-school-common.wxss';

/* 发布家长测评：单行起步的标题与月份选择。 */

.page {
  padding: 24rpx 32rpx 56rpx;
}

.form-label--first {
  margin-top: 0;
}

.title-field {
  min-height: 88rpx;
}

.title-input {
  width: 100%;
  min-height: 40rpx;
  padding: 0;
  border: 0;
  box-sizing: content-box;
  background: transparent;
  color: var(--fg);
  font-size: 26rpx;
  line-height: 40rpx;
}

.full {
  width: 100%;
}

.full--gap {
  margin-top: 24rpx;
}

/* 加载中、取数失败、本班没有记录，三种情况共用一块占位 */
.empty {
  padding: 40rpx;
  border-radius: 32rpx;
  background: var(--surface);
  color: var(--muted);
  text-align: center;
  font-size: 26rpx;
}

/* 学期期间取当前学期，只读；月度期间使用月份选择器。 */
.select--readonly {
  color: var(--muted);
  background: var(--accent-light);
}

/* 表单底下那句说明 */
.hint--gap {
  display: block;
  margin-top: 16rpx;
}
