@import '/styles/home-school-common.wxss';

/* 发布家长测评 —— 页面本身没有额外样式，全部来自共用样式。 */

.page {
  padding: 24rpx 32rpx 56rpx;
}

.form-label--first {
  margin-top: 0;
}

.full {
  width: 100%;
}

.full--gap {
  margin-top: 24rpx;
}

/* 加载中、取数失败、本班没有记录，三种情况共用一块占位 */
.empty {
  padding: 40rpx;
  border-radius: 32rpx;
  background: var(--surface);
  color: var(--muted);
  text-align: center;
  font-size: 26rpx;
}
