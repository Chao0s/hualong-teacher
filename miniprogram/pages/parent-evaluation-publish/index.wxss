@import '/styles/home-school-common.wxss';

/* 发布家长测评 —— 页面本身没有额外样式，全部来自共用样式。 */

.page {
  padding: 24rpx 32rpx 56rpx;
}

.form-label--first {
  margin-top: 0;
}

.full {
  width: 100%;
}

.full--gap {
  margin-top: 24rpx;
}

/* 加载中、取数失败、本班没有记录，三种情况共用一块占位 */
.empty {
  padding: 40rpx;
  border-radius: 32rpx;
  background: var(--surface);
  color: var(--muted);
  text-align: center;
  font-size: 26rpx;
}

/* 两个 picker 并排：日期宽、钟点窄。与发布新任务那一页同一个比例 */
.time-row {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 16rpx;
  margin-top: 12rpx;
}

/* 期间那一格是派生值，不给控件 —— 做成不可点的样子，别让人以为能改 */
.select--readonly {
  color: var(--muted);
  background: var(--accent-light);
}

/* 表单底下那句说明 */
.hint--gap {
  display: block;
  margin-top: 16rpx;
}
