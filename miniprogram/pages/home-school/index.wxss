@import '/styles/home-school-common.wxss';

/* 家园社共育 —— 本页自己的样式，对照原型 screens/home-school.html 的内联块。 */

.page {
  padding: 24rpx 32rpx calc(200rpx + env(safe-area-inset-bottom));
}

.metric-row--gap {
  margin-bottom: 16rpx;
}

/* 四列：姓名与三项状态。空心/实心含义仅作用于本页。 */
.prog-row {
  grid-template-columns: minmax(0, 1.2fr) repeat(3, minmax(0, 1fr));
}

.prog-cell {
  padding: 22rpx 6rpx;
  font-size: 26rpx;
}

.prog-row--head .prog-cell {
  font-size: 24rpx;
}

.prog-cell--name {
  padding-left: 16rpx;
  font-size: 26rpx;
  word-break: break-all;
  white-space: normal;
}

.prog-cell .progress-dot {
  margin: 0 auto;
}

.progress-dot {
  width: 22rpx;
  height: 22rpx;
  flex-shrink: 0;
  border: 3rpx solid var(--accent-dark);
  border-radius: 50%;
}

.progress-dot--done {
  background: var(--accent-dark);
}

.progress-dot--miss {
  background: transparent;
}

.progress-legend {
  display: flex;
  justify-content: flex-start;
  gap: 36rpx;
  margin: 24rpx 0;
}

.progress-legend__item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  color: var(--muted);
}
