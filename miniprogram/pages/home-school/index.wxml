<!-- 家园社共育 —— 对照原型 screens/home-school.html。
     原型的完成度汇总是一张 <table>，小程序没有表格标签，改成网格行，列宽在 wxss 里给。 -->
<view class="page">

  <!-- 暂保留无文字的头图占位，后续替换为正式 banner 图片。 -->
  <view class="banner"></view>

  <view class="sec">快捷入口</view>
  <view class="entry-grid">
    <view
      class="entry-card"
      hover-class="list-card--hover"
      hover-stay-time="80"
      wx:for="{{entries}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onEntryTap"
    >
      <view class="entry-icon">{{item.glyph}}</view>
      <text class="entry-label">{{item.label}}</text>
    </view>
  </view>

  <view class="sec">完成度汇总</view>
  <text class="hint" wx:if="{{loading}}">正在加载本班进度…</text>
  <view class="hint" wx:elif="{{error}}" bindtap="onRetry">{{error}}　点此重试</view>

  <block wx:else>
  <view class="metric-row metric-row--gap">
    <view class="metric" wx:for="{{metrics}}" wx:key="label">
      <text class="metric__n {{item.amber ? 'metric__n--amber' : ''}}">{{item.value}}</text>
      <text class="metric__l">{{item.label}}</text>
    </view>
  </view>

  <view class="table-wrap" wx:if="{{rows.length}}">
    <view class="prog-row prog-row--head">
      <text class="prog-cell prog-cell--name">幼儿</text>
      <text class="prog-cell">在园时光</text>
      <text class="prog-cell">亲子活动</text>
    </view>
    <view class="prog-row" wx:for="{{rows}}" wx:key="childId" wx:for-item="row">
      <text class="prog-cell prog-cell--name">{{row.name}}</text>
      <view class="prog-cell" wx:for="{{row.cells}}" wx:key="index" wx:for-item="cell">
        <view class="progress-dot progress-dot--{{cell.state}}" aria-label="{{cell.label}}"></view>
      </view>
    </view>
  </view>

  <text class="hint" wx:if="{{!rows.length}}">本班暂无在园幼儿。</text>
  <view class="progress-legend">
    <view class="progress-legend__item"><view class="progress-dot progress-dot--done"></view><text>已完成</text></view>
    <view class="progress-legend__item"><view class="progress-dot progress-dot--miss"></view><text>未完成</text></view>
  </view>
  </block>
</view>

<hl-tabbar active="family" />
