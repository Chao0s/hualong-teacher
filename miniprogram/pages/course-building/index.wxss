/* 课程建设 —— 逐条对照原型 screens/course-building.html。1px 记 2rpx。
 * 这一页原型底部没有导航条，所以页面底部只留原型的 28px。 */

.page {
  padding: 24rpx 32rpx 56rpx;
}

/* ── 图文长文 ──────────────────────────────────────────────────────────── */

.article {
  border: 1rpx solid var(--border);
  border-radius: 40rpx;
  background: var(--surface);
  overflow: hidden;
  margin-bottom: 28rpx;
}

/* 原型的封面叠了两层背景：一层斜向渐变，一层右上角的径向高光。 */
.article__cover {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  min-height: 328rpx;
  padding: 44rpx 36rpx;
  color: #fff;
  background:
    linear-gradient(135deg, rgba(15, 118, 110, 0.92), rgba(24, 155, 145, 0.82)),
    radial-gradient(circle at 82% 12%, rgba(255, 255, 255, 0.28), transparent 34%);
}

.article__ring {
  position: absolute;
  right: 36rpx;
  top: 36rpx;
  width: 156rpx;
  height: 156rpx;
  border-radius: 50%;
  border: 28rpx solid rgba(255, 255, 255, 0.16);
}

.article__kicker {
  position: relative;
  z-index: 1;
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.8);
}

.article__title {
  position: relative;
  z-index: 1;
  margin-top: 16rpx;
  font-size: 48rpx;
  line-height: 1.18;
  font-weight: 800;
}

.article__desc {
  position: relative;
  z-index: 1;
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: rgba(255, 255, 255, 0.9);
}

.article__body {
  padding: 36rpx 32rpx 32rpx;
}

.article__lead {
  display: block;
  font-size: 28rpx;
  line-height: 1.85;
  color: #263333;
  font-weight: 500;
}

/* 原型 `.article h2` 前面那根青色小竖条。 */
.article__h2 {
  display: flex;
  align-items: center;
  margin: 40rpx 0 18rpx;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.35;
}

.article__h2::before {
  content: '';
  width: 8rpx;
  height: 32rpx;
  border-radius: 999rpx;
  background: var(--accent);
  margin-right: 16rpx;
}

.caption {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--muted);
}

.intro {
  display: block;
  font-size: 26rpx;
  line-height: 1.7;
  color: #3b4545;
}

/* ── 体系架构图 ────────────────────────────────────────────────────────── */

.flow-chart {
  margin-top: 24rpx;
  padding: 28rpx;
  border: 1rpx solid var(--border);
  border-radius: 36rpx;
  background: #f8fbfb;
}

.flow-main {
  padding: 28rpx 20rpx;
  border-radius: 32rpx;
  background: var(--accent-light);
  color: var(--accent-dark);
  font-size: 32rpx;
  font-weight: 800;
  text-align: center;
}

.flow-row {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16rpx;
  margin-top: 20rpx;
}

.flow-item {
  padding: 22rpx 24rpx;
  border: 1rpx solid var(--border);
  border-radius: 28rpx;
  background: #fff;
}

.flow-item__label {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.flow-item__desc {
  display: block;
  font-size: 22rpx;
  line-height: 1.45;
  color: var(--muted);
}

/* ── 五个范畴 ──────────────────────────────────────────────────────────── */

.domain-list {
  display: grid;
  gap: 20rpx;
  margin-top: 20rpx;
}

.domain-item {
  display: grid;
  grid-template-columns: 72rpx 1fr;
  gap: 20rpx;
  align-items: start;
  padding: 24rpx;
  border: 1rpx solid var(--border);
  border-radius: 30rpx;
  background: #fbfdfd;
}

.domain-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: var(--accent-light);
  color: var(--accent-dark);
  font-size: 36rpx;
  font-weight: 800;
}

.domain-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
}

.domain-desc {
  display: block;
  font-size: 24rpx;
  line-height: 1.6;
  color: #596363;
}

/* ── 理念图文版面 ──────────────────────────────────────────────────────── */

.image-panel {
  margin-top: 24rpx;
  padding: 28rpx;
  border: 1rpx solid #cfe0de;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #edf8f6, #fff);
}

.image-panel__title {
  display: block;
  margin-bottom: 20rpx;
  font-size: 26rpx;
  font-weight: 800;
  color: var(--accent-dark);
}

.mini-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.mini-grid__item {
  padding: 20rpx 16rpx;
  border: 1rpx solid var(--border);
  border-radius: 24rpx;
  background: #fff;
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
  color: #425050;
}

/* ── 附件下载 ──────────────────────────────────────────────────────────── */

.sec {
  margin: 40rpx 0 20rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.chunk {
  padding: 28rpx;
  border: 1rpx solid var(--border);
  border-radius: 32rpx;
  background: var(--surface);
  margin-bottom: 24rpx;
}

.file-list {
  display: grid;
  gap: 18rpx;
}

.file-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid var(--border);
  border-radius: 26rpx;
  background: #fff;
}

.file-name {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.35;
}

.download {
  flex: 0 0 auto;
  padding: 12rpx 20rpx;
  border: 1rpx solid var(--accent);
  border-radius: 999rpx;
  background: var(--accent-light);
  color: var(--accent-dark);
  font-size: 24rpx;
  font-weight: 700;
  white-space: nowrap;
}
