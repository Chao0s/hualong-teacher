@import '/styles/home-school-common.wxss';
@import '/styles/album-sheet.wxss';

/* 成长册 —— 本页自己的样式，对照原型 screens/growth-book.html 的内联块。1px 记 2rpx。
 * 浮层外壳（sheet-mask / sheet / sheet-head / close / sheet-actions）原型这几页写的尺寸
 * 和相册那份一字不差，直接 @import 复用，这里只写摘要卡、表格外框和勾选行。 */

.page {
  padding: 24rpx 32rpx 56rpx;
}

/* ── 摘要卡 ────────────────────────────────────────────────────────────── */

.summary-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  border-radius: 32rpx;
  background: var(--surface);
}

.summary-card__grow {
  flex: 1;
  min-width: 0;
}

.summary-card__title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
}

.summary-card__list {
  display: block;
  margin-top: 10rpx;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.5;
}

.summary-card__enter {
  color: var(--accent);
  font-size: 24rpx;
  font-weight: 600;
  white-space: nowrap;
}

/* 原型给这一行写的是 style="margin-bottom:12px" */
.action-row--gap {
  margin-bottom: 24rpx;
}

/* 原型 style="margin:-6px 0 12px"：往上贴住按钮行 */
.hint--gate {
  display: block;
  margin: -12rpx 0 24rpx;
}

/* ── 班级定稿进度 ──────────────────────────────────────────────────────── */

.chunk__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.chunk__main {
  flex: 1;
  min-width: 0;
}

.chunk__title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
}

.chunk__note {
  display: block;
  margin-top: 8rpx;
}

.chunk__value {
  color: var(--accent);
  font-size: 40rpx;
  font-weight: 700;
}

/* ── 栏目进度表 ────────────────────────────────────────────────────────── */

/* 共用样式的 .table-wrap 是 overflow:hidden 的白底圆角框，这里要能横向滚，另写一个 */
.book-table-wrap {
  border-radius: 24rpx;
  background: var(--surface);
  white-space: nowrap;
}

.book-table {
  display: inline-block;
}

/* 原型 style="padding:0 12px 8px" */
.hint--foot {
  display: block;
  padding: 0 24rpx 16rpx;
}

/* ── 浮层里的勾选行 ────────────────────────────────────────────────────── */

.sheet-list {
  max-height: 640rpx;
}

.check-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid var(--border);
  border-radius: 26rpx;
  font-size: 28rpx;
  font-weight: 700;
}

/* 问题幼儿：原型 .check-row.blocked { opacity:.45 } */
.check-row--blocked {
  opacity: 0.45;
}

.check-row__main {
  flex: 1;
  min-width: 0;
}

.check-row__name {
  display: block;
}

.check-row__desc {
  display: block;
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 22rpx;
  font-weight: 400;
}

/* 原型用原生 checkbox；小程序的不好改样式，自己画一个方框。 */
.checkbox {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid var(--border);
  border-radius: 8rpx;
  background: #fff;
  color: #fff;
  font-size: 24rpx;
  line-height: 1;
}

.checkbox--on {
  border-color: var(--accent);
  background: var(--accent);
}

.hint--sheet {
  display: block;
  margin-top: 20rpx;
}
