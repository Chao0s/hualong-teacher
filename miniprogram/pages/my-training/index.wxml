<!-- 我的研修 —— 对照原型 screens/my-training.html。

     徽章读的是**参与状态**（已报名／已取消／已完成），不是活动阶段 ——
     「已取消的未开始活动」与「已报名的未开始活动」对教师是两件事。
     活动阶段放在脚上的胶囊里。

     撤回的活动仍然列出来（报名记录是真的），但点不进去：详情端点对 s5 只回壳。 -->
<view class="page">

  <view class="sec">报名记录</view>

  <view class="hint" wx:if="{{loading}}">正在加载…</view>
  <view class="hint" wx:elif="{{error}}" bindtap="onRetry">{{error}}　点此重试</view>

  <block wx:elif="{{records.length}}">
    <view
      class="card"
      hover-class="{{item.tappable ? 'card--hover' : ''}}"
      hover-stay-time="80"
      wx:for="{{records}}"
      wx:key="key"
      data-id="{{item.id}}"
      bindtap="onCardTap"
    >
      <view class="top">
        <text class="title">{{item.title}}</text>
        <text class="badge badge--{{item.state}}">{{item.stateText}}</text>
      </view>
      <text class="meta">{{item.meta}}</text>
      <text class="summary">{{item.summary}}</text>
      <view class="foot" wx:if="{{item.pills.length}}">
        <text class="pill" wx:for="{{item.pills}}" wx:key="*this" wx:for-item="pill">{{pill}}</text>
      </view>
    </view>
  </block>

  <view class="hint" wx:else>你还没有报名过研修。</view>

</view>
