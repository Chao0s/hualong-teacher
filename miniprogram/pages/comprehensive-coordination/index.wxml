<!-- 综合协调部 —— 对照原型 screens/comprehensive-coordination.html。
     三块入口结构一样，只有列数不同（行政统筹 3 列，另外两块 2 列），合成一份数据循环。 -->
<view class="page">

  <view class="banner">
    <view class="banner__ring"></view>
    <text class="banner__kicker">园务协同支持</text>
    <text class="banner__title">统筹行政、人事与后勤保障</text>
    <text class="banner__desc">集中查看园内制度、通知、安全卫生与教师发展支持事项。</text>
    <view class="banner__mark">协</view>
  </view>

  <block wx:for="{{sections}}" wx:key="title" wx:for-item="section">
    <view class="sec">{{section.title}}</view>
    <view class="entry-grid {{section.cols === 3 ? 'entry-grid--three' : ''}}">
      <view
        class="entry-card"
        hover-class="entry-card--hover"
        hover-stay-time="80"
        wx:for="{{section.entries}}"
        wx:key="type"
        data-type="{{item.type}}"
        bindtap="onEntryTap"
      >
        <view class="ec-icon ec-icon--{{item.tone}}">{{item.glyph}}</view>
        <text class="entry-card__title">{{item.title}}</text>
        <text class="entry-card__desc">{{item.desc}}</text>
      </view>
    </view>
  </block>

</view>

<hl-tabbar active="coord" />
