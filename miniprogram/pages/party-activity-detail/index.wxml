<!-- 党建活动 · 活动介绍 —— 对照原型 screens/party-activity-detail.html。

     原型的图文区是四个写着「活动现场图」「分组研讨」「成果展示」的占位色块。
     它们看起来像内容，实际没有任何数据源：契约的 PartyActivity.file_refs 只回
     {file_id, usage_key}，数据集里三场已发布活动的 file_refs 又都是空数组。
     所以改成跟着 file_refs 走 —— 有附件才渲染，没有就不画。理由与附件下载那一块
     相同，见 index.js 头注。 -->
<view class="page">

  <view class="card" wx:if="{{loading}}">
    <text class="card__body">正在加载…</text>
  </view>

  <view class="card" wx:elif="{{error}}">
    <text class="card__body">{{error}}</text>
    <view class="downloads">
      <view class="download" hover-class="download--hover" bindtap="onRetry">
        <text class="download__name">加载失败</text>
        <text class="download__op">重试</text>
      </view>
    </view>
  </view>

  <block wx:else>
    <view class="cover">
      <text class="cover__title">{{activity.title}}</text>
      <text class="cover__sub">{{activity.sub}}</text>
    </view>

    <view class="card">
      <view class="row">
        <text class="row__label">活动时间</text>
        <text>{{activity.time}}</text>
      </view>
    </view>

    <view class="card">
      <text class="card__title">图文介绍</text>
      <text class="card__body">{{activity.body}}</text>
      <view class="photos" wx:if="{{files.length}}">
        <view class="photo-main">活动现场图</view>
        <view class="photo-row">
          <view class="ph">分组研讨</view>
          <view class="ph">成果展示</view>
        </view>
      </view>
    </view>

    <view class="card" wx:if="{{files.length}}">
      <text class="card__title">附件下载</text>
      <view class="downloads">
        <view
          class="download"
          hover-class="download--hover"
          hover-stay-time="80"
          wx:for="{{files}}"
          wx:key="fileId"
          data-name="{{item.name}}"
          bindtap="onDownload"
        >
          <text class="download__name">{{item.name}}</text>
          <text class="download__op">下载</text>
        </view>
      </view>
    </view>
  </block>

</view>
