<!-- 党建学习 · 文件预览 —— 对照原型 screens/party-study-detail.html。
     原型模板里那句写死的「PDF · 2.4MB」已删：那是一个对每份文件都不对的常数。
     理由见 index.js 头注第 2 条。 -->
<view class="page">

  <view class="doc" wx:if="{{loading}}">
    <text class="doc__title">正在加载…</text>
  </view>

  <view class="doc" wx:elif="{{error}}">
    <text class="doc__title">{{error}}</text>
    <view class="actions">
      <view class="btn btn--primary" hover-class="btn--hover" bindtap="onRetry">重试</view>
    </view>
  </view>

  <view class="doc" wx:else>
    <text class="badge">{{doc.type}}</text>
    <text class="doc__title">{{doc.title}}</text>
    <view class="doc__meta">
      <text>{{doc.date}}</text>
      <text>{{doc.owner}}</text>
    </view>

    <view class="preview">
      <text class="preview__title">文件预览</text>
      <!-- 正文段数由内容决定，不固定两段 -->
      <text class="preview__p" wx:for="{{doc.paragraphs}}" wx:key="*this">{{item}}</text>

      <!-- video_links 是可空列，没有视频就整块不渲染 -->
      <view class="video-box" wx:if="{{videos.length}}">
        <text class="video-box__title">相关视频学习</text>
        <text class="video-box__hint">请复制链接到浏览器中打开</text>
        <view class="video-list">
          <view
            class="video-link"
            hover-class="video-link--hover"
            hover-stay-time="80"
            wx:for="{{videos}}"
            wx:key="url"
            data-url="{{item.url}}"
            bindtap="onCopyUrl"
          >
            <text class="video-link__name">{{item.name}}</text>
            <text class="video-link__op">复制链接</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 两个按钮走同一条链接、同一个函数：小程序上「预览」就是「下到临时文件再
         wx.openDocument」，平台没有第二种打开方式。没有附件时整块不渲染。 -->
    <view class="actions" wx:if="{{file}}">
      <view class="btn btn--primary" hover-class="btn--hover" data-action="预览" bindtap="onOpenFile">在线预览</view>
      <view class="btn btn--secondary" hover-class="btn--hover" data-action="下载" bindtap="onOpenFile">下载文件</view>
    </view>
  </view>

</view>
