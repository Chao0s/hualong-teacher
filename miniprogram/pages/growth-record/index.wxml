<!-- 儿童成长档案 —— 进度表接 GET /growth-records。
     表头在原型里是两行 <th>，带 rowspan/colspan。
     小程序没有表格标签，这里用网格的 grid-row / grid-column 跨格做出同样的形状。

     五列：家长月度 / 家长学期 / 教师月度 / 教师学期 / 综合。原型第六列「成长册」
     去掉了 —— db_growth_record 与 GrowthRecord schema 都没有成长册状态列。 -->
<view class="page">

  <view class="sec sec--first">儿童评价</view>
  <view class="record-entry-row">
    <view
      class="record-entry"
      hover-class="list-card--hover"
      hover-stay-time="80"
      wx:for="{{entries}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onEntryTap"
    >{{item.label}}</view>
  </view>

  <view class="sec">评价进度</view>
  <text class="hint" wx:if="{{loading}}">正在加载评价进度…</text>
  <view class="hint" wx:elif="{{error}}" bindtap="onRetry">{{error}}　点此重试</view>
  <text class="hint" wx:elif="{{!rows.length}}">本班暂无评价进度记录。</text>
  <block wx:else>
  <view class="table-wrap">
    <view class="rec-head">
      <text class="rec-head__cell rec-head__cell--tall rec-head__cell--name">幼儿</text>
      <text class="rec-head__cell rec-head__cell--wide">家长</text>
      <text class="rec-head__cell rec-head__cell--wide">教师</text>
      <text class="rec-head__cell rec-head__cell--tall">综合</text>
      <text class="rec-head__cell rec-head__cell--sub">月度</text>
      <text class="rec-head__cell rec-head__cell--sub">学期</text>
      <text class="rec-head__cell rec-head__cell--sub">月度</text>
      <text class="rec-head__cell rec-head__cell--sub">学期</text>
    </view>

    <view class="rec-row" wx:for="{{rows}}" wx:key="childId" wx:for-item="row">
      <text class="rec-cell rec-cell--name">{{row.name}}</text>
      <view class="rec-cell" wx:for="{{row.states}}" wx:key="index" wx:for-item="state">
        <view class="dot-cell dot-cell--{{state}}" aria-label="{{state === 'done' ? '已完成' : '未完成'}}"></view>
      </view>
    </view>
  </view>

  <view class="dot-legend">
    <view class="dot-legend__item"><view class="dot-cell dot-cell--done"></view>已完成</view>
    <view class="dot-legend__item"><view class="dot-cell dot-cell--miss"></view>未完成</view>
  </view>
  </block>

</view>
