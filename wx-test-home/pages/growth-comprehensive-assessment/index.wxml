<!-- 综合评估 —— 对照原型 screens/growth-comprehensive-assessment.html。
     进度和状态都从共用的草稿存储读（utils/assessment-store.js），
     从填写页返回时 onShow 会重新算一遍，和原型监听 pageshow 是一个意思。 -->
<view class="page">

  <view class="sec sec--first">综合评估</view>
  <view class="chunk assessment-start">
    <view class="assessment-start__text">
      <text class="assessment-start__title">开始评估</text>
      <text class="assessment-start__desc">选择幼儿后，按健康、语言、社会、科学、艺术五大领域完成李克特量表评分。</text>
    </view>
    <view class="btn btn--primary" hover-class="btn--hover" bindtap="onStart">开始</view>
  </view>

  <view class="assessment-grid">
    <view class="assessment-card">
      <view>
        <text class="assessment-card__title">进度</text>
        <text class="assessment-card__desc">中二班综合评估已完成人数</text>
      </view>
      <text class="ratio">{{doneRatio}}</text>
    </view>
    <view class="assessment-card" hover-class="list-card--hover" hover-stay-time="80" bindtap="onClassReport">
      <view>
        <text class="assessment-card__title">班级评估</text>
        <text class="assessment-card__desc">查看五大领域汇总分析与强弱项报告</text>
      </view>
      <view class="arrow">›</view>
    </view>
  </view>

  <view class="section-head">
    <text class="sec sec--flat">个人进度</text>
    <view class="outline-btn" hover-class="btn--hover" bindtap="onOpenExport">导出报告</view>
  </view>

  <view class="student" wx:for="{{students}}" wx:key="id">
    <view class="student__main">
      <text class="student__name">{{item.name}}</text>
      <text class="student__sub">{{item.sub}}</text>
    </view>
    <text class="pill pill--{{item.state}}">{{item.stateLabel}}</text>
    <view class="small-btn" hover-class="btn--hover" data-id="{{item.id}}" data-state="{{item.state}}" bindtap="onStudentTap">{{item.action}}</view>
  </view>

</view>

<!-- 导出综合评估报告 -->
<view class="sheet-mask" wx:if="{{exportOpen}}" bindtap="onCloseExport"></view>
<view class="sheet" wx:if="{{exportOpen}}">
  <view class="sheet-head">
    <text class="sheet-head__title">导出综合评估报告</text>
    <view class="close" bindtap="onCloseExport">×</view>
  </view>

  <view class="check-row" bindtap="onToggleAll">
    <view class="check-row__main">
      <text class="check-row__name">全选</text>
      <text class="check-row__desc">导出所有已完成和草稿儿童</text>
    </view>
    <view class="checkbox {{allChecked ? 'checkbox--on' : ''}}">{{allChecked ? '✓' : ''}}</view>
  </view>

  <view class="check-row" wx:for="{{exportables}}" wx:key="id" wx:for-index="ei" data-index="{{ei}}" bindtap="onToggleRow">
    <view class="check-row__main">
      <text class="check-row__name">{{item.name}}</text>
      <text class="check-row__desc">{{item.desc}}</text>
    </view>
    <view class="checkbox {{item.checked ? 'checkbox--on' : ''}}">{{item.checked ? '✓' : ''}}</view>
  </view>

  <view class="sheet-actions">
    <view class="btn btn--ghost" hover-class="btn--hover" bindtap="onCloseExport">取消</view>
    <view class="btn btn--primary" hover-class="btn--hover" bindtap="onConfirmExport">导出</view>
  </view>
</view>
