<!-- 首页 —— 对照原型 screens/home.html。
     原型顶部那条状态栏和标题栏是网页模拟出来的手机外壳，小程序由微信自己画，
     所以这里不复刻，标题走 index.json 的 navigationBarTitleText。 -->
<view class="page">

  <view class="banner">
    <text class="banner__title">{{banner.title}}</text>
    <text class="banner__sub">{{banner.sub}}</text>
  </view>

  <view class="sec">
    <text class="sec__title">近期任务</text>
  </view>
  <view class="todo-cards">
    <view
      class="todo-card"
      hover-class="todo-card--hover"
      hover-stay-time="80"
      wx:for="{{todos}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onTodoTap"
    >
      <view class="dot-icon dot-icon--{{item.key}}">{{item.glyph}}</view>
      <text class="todo-title">{{item.title}}</text>
      <text class="todo-badge todo-badge--{{item.tone}}">{{item.badge}}</text>
    </view>
  </view>

  <view class="sec">
    <text class="sec__title">常用入口</text>
  </view>
  <view class="quick-grid">
    <view
      class="quick-item"
      hover-class="quick-item--hover"
      hover-stay-time="80"
      wx:for="{{quickEntries}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onQuickTap"
    >
      <view class="quick-icon quick-icon--{{item.key}}"></view>
      <text class="quick-label">{{item.label}}</text>
    </view>
  </view>

  <view class="sec">
    <text class="sec__title">推荐课程案例</text>
    <text class="sec__more" bindtap="onCaseMore">全部案例 ›</text>
  </view>
  <view class="resource-grid">
    <view
      class="resource-card"
      hover-class="resource-card--hover"
      hover-stay-time="80"
      wx:for="{{cases}}"
      wx:key="id"
      bindtap="onCaseTap"
    >
      <view class="resource-thumb resource-thumb--{{item.tone}}">{{item.glyph}}</view>
      <text class="resource-name">{{item.name}}</text>
      <text class="resource-tag">{{item.tag}}</text>
    </view>
  </view>

</view>

<hl-tabbar active="home" />
