/* 课程资源 —— 逐条对照原型 screens/resource-center.html。1px 记 2rpx。 */

.page {
  padding: 24rpx 32rpx calc(200rpx + env(safe-area-inset-bottom));
}

/* ── 搜索条 ────────────────────────────────────────────────────────────── */

.search-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 28rpx;
  margin-bottom: 28rpx;
  border: 1rpx solid var(--border);
  border-radius: 48rpx;
  background: var(--surface);
}

.search-bar__icon {
  flex: 0 0 auto;
  width: 36rpx;
  height: 36rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 36rpx 36rpx;
}

.search-bar__input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--fg);
}

.search-bar__ph {
  color: var(--muted);
}

.search-bar__action {
  flex: 0 0 auto;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: var(--accent);
  color: var(--surface);
  font-size: 24rpx;
  font-weight: 600;
}

/* ── 两个大入口 ────────────────────────────────────────────────────────── */

.hub-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.hub-card {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  min-height: 232rpx;
  padding: 28rpx;
  border: 1rpx solid var(--border);
  border-radius: 32rpx;
  background: var(--surface);
}

.hub-card--resource {
  background: linear-gradient(180deg, var(--accent-light) 0%, var(--surface) 82%);
}

.hub-card--case {
  background: linear-gradient(180deg, var(--green-light) 0%, var(--surface) 82%);
}

.hub-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.hub-icon {
  flex: 0 0 auto;
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  border: 1rpx solid var(--border);
  background-color: var(--surface);
  background-repeat: no-repeat;
  background-position: center;
  background-size: 38rpx 38rpx;
}

.hub-arrow {
  color: var(--muted);
  font-size: 36rpx;
  line-height: 1;
}

.hub-title {
  display: block;
  margin-bottom: 8rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.hub-desc {
  display: block;
  font-size: 24rpx;
  line-height: 1.45;
  color: var(--muted);
}

/* ── 分组标题 ──────────────────────────────────────────────────────────── */

.sec {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 40rpx 0 20rpx;
}

.sec__title {
  font-size: 32rpx;
  font-weight: 700;
}

.sec__more {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--muted);
}

/* ── 资源卡 / 案例卡 ───────────────────────────────────────────────────── */

.card-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.info-card {
  display: flex;
  gap: 24rpx;
  align-items: stretch;
  padding: 24rpx;
  border: 1rpx solid var(--border);
  border-radius: 28rpx;
  background: var(--surface);
}

/* 原型的按下态是 `color-mix(in oklab, var(--surface), var(--bg) 38%)`，
 * 小程序不认 color-mix，换成算好的定值。 */
.card--hover {
  background: #f6faf9;
}

.thumb {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 116rpx;
  border-radius: 24rpx;
  border: 1rpx solid var(--border);
  flex: 0 0 auto;
}

.thumb--accent { background: var(--accent-light); }
.thumb--green { background: var(--green-light); }
.thumb--amber { background: var(--amber-light); }

.thumb__icon {
  width: 48rpx;
  height: 48rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 48rpx 48rpx;
}

.card-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 10rpx;
}

.card-name {
  font-size: 30rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.badge {
  flex: 0 0 auto;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: var(--accent-dark);
  background: var(--accent-light);
}

.card-meta {
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.45;
}

.card-summary {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--fg);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

