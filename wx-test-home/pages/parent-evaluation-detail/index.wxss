@import '/styles/home-school-common.wxss';

/* 家长测评进度 —— 页面本身没有额外样式，全部来自共用样式。 */

.page {
  padding: 24rpx 32rpx 56rpx;
}

.metric-row--gap {
  margin-top: 28rpx;
}

/* 四列：幼儿 / 已读 / 已完成 / 提交内容预览 */
.prog-row {
  grid-template-columns: 120rpx 96rpx 128rpx 1fr;
}

.prog-cell {
  padding: 20rpx 8rpx;
  font-size: 22rpx;
}

.prog-cell--name {
  padding-left: 16rpx;
}
