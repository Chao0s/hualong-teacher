<!-- 亲子任务 —— 对照原型 screens/parent-tasks.html。 -->
<view class="page">

  <view class="sec sec--first">发布新任务</view>
  <view class="publish-card" hover-class="list-card--hover" hover-stay-time="80" bindtap="onPublish">
    <view class="publish-icon">＋</view>
    <view class="publish-main">
      <text class="publish-title">发布新任务</text>
      <text class="publish-meta">进入后选择日常任务或社区任务，并填写任务背景与任务详情。</text>
    </view>
    <text class="chev">›</text>
  </view>

  <view class="sec">历史任务</view>
  <view
    class="list-card"
    hover-class="list-card--hover"
    hover-stay-time="80"
    wx:for="{{tasks}}"
    wx:key="title"
    bindtap="onTaskTap"
  >
    <view class="mark {{item.tone ? 'mark--' + item.tone : ''}}">{{item.glyph}}</view>
    <view class="list-main">
      <text class="list-title">{{item.title}}</text>
      <view class="list-meta">
        <text class="type-pill {{item.community ? 'type-pill--community' : ''}}">{{item.typeLabel}}</text>
        <text> {{item.meta}}</text>
      </view>
    </view>
    <text class="chev">›</text>
  </view>

</view>
