@import '/styles/home-school-common.wxss';

/* 教师评价 —— 本页自己的样式，对照原型 screens/teacher-evaluation.html 的内联块。 */

.page {
  padding: 24rpx 32rpx 56rpx;
}

.eval-entry-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.eval-entry {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 120rpx;
  padding: 26rpx 24rpx;
  border: 1rpx solid var(--border);
  border-radius: 32rpx;
  background: var(--surface);
  color: var(--fg);
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.3;
}

.eval-entry--primary {
  border-color: #a7f3d0;
  background: #ecfdf5;
  color: #047857;
}

/* 五列：幼儿 + 四个进度圆点 */
.prog-row {
  grid-template-columns: 124rpx repeat(4, 1fr);
}
