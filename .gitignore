.od-skills/
*.artifact.json
~$*

# Local design-tool workspaces
lanhu-mcp/
*.pen

# Per-developer devtools config, never shared. The AppID now lives in the
# tracked project.config.json, which the devtools rewrite on save.
project.private.config.json

# Tooling dependencies. The mini program itself stays zero-dependency —
# node_modules serves tools/ only and never enters miniprogram/.
node_modules/

# Upload keys. miniprogram-ci reads a PEM private key; it must never be
# committed. Keep it outside the repository and pass MP_PRIVATE_KEY.
*.key

# Generated by npm run spec:inventory. Derived from the contract in
# hualong-backend, so committing it would create a second, staler truth.
tools/.report/

# tools/build-api-doc.mjs output. Generated at publish time, never committed —
# a committed copy of the contract would go stale silently.
dist/

# 原型抓取的临时抽取目录。captures/*.txt 是源料要留，_extracted/ 是从它们
# 现抽出来的 body/css/js，一条命令可重建，不进版本库。
captures/_extracted/
